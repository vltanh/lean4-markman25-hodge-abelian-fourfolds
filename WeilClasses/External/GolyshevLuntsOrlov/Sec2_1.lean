module

public import WeilClasses.Spinor.Integral
import TauCeti.LinearAlgebra.CliffordAlgebra.Dimension
import TauCeti.LinearAlgebra.ExteriorAlgebra.Dimension
import TauCeti.LinearAlgebra.ExteriorAlgebra.IntegralLattice
import TauCeti.LinearAlgebra.ExteriorAlgebra.End

/-!
# Golyshev–Lunts–Orlov, Proposition 3.2.1(e), as used in §2.1 and §2.2 of the paper

[GLO] V. Golyshev, V. Lunts, D. Orlov, *Mirror symmetry for abelian varieties*,
J. Algebraic Geom. 10 (2001), 433–496, Proposition 3.2.1(e): the homomorphism
`m : C(V) → End(S)` (2.1.3), extending `m_{(w,θ)} = L_w + D_θ` from
`V = H¹(X, ℤ) ⊕ H¹(X̂, ℤ)` to the Clifford algebra, is an isomorphism over `ℤ`.

The paper uses it

* in §2.1, right after (2.1.3) ("which is in fact an isomorphism, by [GLO, Prop. 3.2.1(e)]"), and at
  the end of §2.1 for the isomorphism `m : C(V_K) → End(S_K)` over a field `K`;
* in the proof of Lemma 2.2.6 (footnote): the surjectivity of `m` over `ℤ`, proved in [GLO], gives
  the surjectivity of Chevalley's `φ : S ⊗_ℤ S → C(V)` over `ℤ`.

Model (see `WeilClasses.Spinor.Integral`): the integral Clifford algebra `C(V)` is the subring
`CZ n ⊆ C(V_ℚ)` generated by the lattice `VZ n`, and `End(S)` is the set of endomorphisms of `S_ℚ`
preserving the lattice `S = SZ n` (integer coordinates in the basis `e_K`).

**Proofs** (Stage 2, prover SD).

* Over a field `F`: `m(ι(0, w)) = L_w` and `m(ι(θ, 0)) = D_θ` (`sd_m_ι_inr`, `sd_m_ι_inl`), and the
  creation and contraction operators generate `End(⋀•H¹)` as an algebra
  (`TauCeti.ExteriorAlgebra.creation_contraction_adjoin_eq_top`), so `m` is onto; both sides have
  dimension `2^{4n}` (`CliffordAlgebra.finrank_eq_two_pow`; `End(S)` has dimension `(2^{2n})²`), so
  `m` is bijective.
* Over `ℤ`: `m(ι(v))` preserves `SZ n` for `v ∈ VZ n` (creation by `eᵢ` and contraction by `fᵢ`
  have integral matrices, Tau Ceti's `TauCeti.ExteriorAlgebra.ι_basis_mul_mem_integralLattice`,
  `contractLeft_coord_mem_integralLattice`), hence so does `m(x)` for `x ∈ CZ n`; injectivity is the
  field case; for surjectivity, a lattice-preserving `A` is an integral combination of the matrix
  units `E_{K,L} : e_L ↦ e_K`, and each `E_{K,L}` is a product of creation operators `L_{eᵢ}`,
  contraction operators `D_{fᵢ}` and the projections `L_{eᵢ} D_{fᵢ}`, `1 - L_{eᵢ} D_{fᵢ}`
  (`sd_matrixUnit`: the construction of Tau Ceti's proof of
  `TauCeti.ExteriorAlgebra.creation_contraction_adjoin_eq_top`, whose lemmas are private there and
  are reproduced here), i.e. `E_{K,L} = m(x)` with `x` a polynomial with integer coefficients in
  the `ι(v)`, `v ∈ VZ n`.
-/

@[expose] public section

namespace WeilClasses

open CliffordAlgebra

section Field

variable (F : Type*) [Field F] [CharZero F] (n : ℕ)

/-- `m(ι(0, w)) = L_w`, exterior multiplication by `w`. -/
theorem sd_m_ι_inr (w : H1 F n) :
    m F n (CliffordAlgebra.ι (Q F n) ((0, w) : V F n)) =
      LinearMap.mulLeft F (ExteriorAlgebra.ι F w) := by
  refine LinearMap.ext fun s => ?_
  simp [m, cliffordOp, L, D]

/-- `m(ι(θ, 0)) = D_θ`, contraction with `θ`. -/
theorem sd_m_ι_inl (θ : Module.Dual F (H1 F n)) :
    m F n (CliffordAlgebra.ι (Q F n) ((θ, 0) : V F n)) =
      CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm F (H1 F n))) θ := by
  refine LinearMap.ext fun s => ?_
  simp [m, cliffordOp, L, D]

/-- `m` is onto `End(S_F)`: creation and contraction operators generate `End(⋀•H¹(X, F))`. -/
theorem sd_m_surjective : Function.Surjective (m F n) := by
  rw [← AlgHom.range_eq_top]
  apply top_unique
  rw [← TauCeti.ExteriorAlgebra.creation_contraction_adjoin_eq_top (K := F) (W := H1 F n)]
  apply Algebra.adjoin_le
  rintro f (⟨w, rfl⟩ | ⟨d, rfl⟩)
  · exact ⟨CliffordAlgebra.ι (Q F n) ((0, w) : V F n), sd_m_ι_inr F n w⟩
  · exact ⟨CliffordAlgebra.ι (Q F n) ((d, 0) : V F n), sd_m_ι_inl F n d⟩

/-- `C(V_F)` and `End(S_F)` have the same dimension `2^{4n}`. -/
theorem sd_finrank_C_eq : Module.finrank F (C F n) = Module.finrank F (Module.End F (S F n)) := by
  have hV : Module.finrank F (V F n) = 2 * n + 2 * n := by
    rw [Module.finrank_eq_card_basis (basisV F n), Fintype.card_fin]
  have hH : Module.finrank F (H1 F n) = 2 * n := Module.finrank_fin_fun F
  rw [CliffordAlgebra.finrank_eq_two_pow, Module.finrank_linearMap,
    TauCeti.ExteriorAlgebra.finrank_eq_two_pow, hV, hH, pow_add]

end Field

/-- **[GLO, Prop. 3.2.1(e)]** after extension of scalars to a field `F` of characteristic zero
(the paper's `m : C(V_K) → End(S_K)` at the end of §2.1): `m : C(V_F) → End(S_F)` is bijective.
Tau Ceti proves the same statement for its own Fock model of the spin representation
(`TauCeti.SpinPolarizationData.cliffordEquivEnd`, with `SpinPolarizationData.hyperbolic`); our `m`
is the composite of that model with the identification `Submodule.snd ≅ H¹(X, F)`.
Proof: `m` is onto (`sd_m_surjective`) between spaces of the same finite dimension
(`sd_finrank_C_eq`). -/
theorem glo_prop3_2_1_e_field (F : Type*) [Field F] [CharZero F] (n : ℕ) :
    Function.Bijective (m F n) :=
  ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank (sd_finrank_C_eq F n)
      (f := (m F n).toLinearMap)).2 (sd_m_surjective F n), sd_m_surjective F n⟩

/-! ## Matrix units of `End(⋀•W)` from creation and contraction operators

The construction of Tau Ceti's proof of `TauCeti.ExteriorAlgebra.creation_contraction_adjoin_eq_top`
(`TauCeti/LinearAlgebra/ExteriorAlgebra/End.lean`, where these definitions and lemmas are private),
reproduced here: the matrix unit `e_t ↦ e_s` is `create s * annihilate t * basisProjection t`. -/

section MatrixUnits

variable {K : Type*} [CommRing K] {W : Type*} [AddCommGroup W] [Module K W]

/-- `L_{bᵢ} ∘ D_{bᵢ^*}`: the projection onto the basis vectors containing `i`. -/
private noncomputable def sd_occ {N : ℕ} (b : Module.Basis (Fin N) K W) (i : Fin N) :
    Module.End K (ExteriorAlgebra K W) :=
  (LinearMap.mulLeft K ((ExteriorAlgebra.ι K) (b i))).comp
    (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W)) (b.coord i))

/-- `1 - L_{bᵢ} ∘ D_{bᵢ^*}`: the projection onto the basis vectors not containing `i`. -/
private noncomputable def sd_vac {N : ℕ} (b : Module.Basis (Fin N) K W) (i : Fin N) :
    Module.End K (ExteriorAlgebra K W) :=
  LinearMap.id - sd_occ b i

/-- The projection onto the line of the basis vector `b_s`. -/
private noncomputable def sd_proj {N : ℕ} (b : Module.Basis (Fin N) K W) (s : Finset (Fin N)) :
    Module.End K (ExteriorAlgebra K W) :=
  List.prod ((List.ofFn fun i : Fin N ↦ i).map fun i ↦
    if i ∈ s then sd_occ b i else sd_vac b i)

private theorem sd_vac_basis {N : ℕ} (b : Module.Basis (Fin N) K W) (i : Fin N)
    (s : Finset (Fin N)) :
    sd_vac b i (b.ExteriorAlgebra s) = if i ∈ s then 0 else b.ExteriorAlgebra s := by
  rw [sd_vac, LinearMap.sub_apply, LinearMap.id_apply, sd_occ, LinearMap.comp_apply,
    LinearMap.mulLeft_apply, TauCeti.ExteriorAlgebra.ι_mul_contractLeft_coord_basis]
  split_ifs <;> simp

private theorem sd_factor_apply {N : ℕ} (b : Module.Basis (Fin N) K W) (s t : Finset (Fin N))
    (i : Fin N) :
    (if i ∈ s then sd_occ b i else sd_vac b i) (b.ExteriorAlgebra t) =
      (if (i ∈ s ↔ i ∈ t) then 1 else 0) • b.ExteriorAlgebra t := by
  by_cases his : i ∈ s <;> by_cases hit : i ∈ t <;>
    simp [-TauCeti.ExteriorAlgebra.contractLeft_coord_basis, his, hit, sd_occ,
      TauCeti.ExteriorAlgebra.ι_mul_contractLeft_coord_basis, sd_vac_basis]

private theorem sd_listProd_factor_apply {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s t : Finset (Fin N)) (l : List (Fin N)) :
    (l.map (fun i ↦ if i ∈ s then sd_occ b i else sd_vac b i)).prod (b.ExteriorAlgebra t) =
      (List.prod (l.map (fun i ↦ (if (i ∈ s ↔ i ∈ t) then 1 else 0 : K))) •
        b.ExteriorAlgebra t) := by
  induction l with
  | nil => simp
  | cons i l ih =>
      rw [List.map_cons, List.prod_cons, Module.End.mul_apply, ih, map_smul, sd_factor_apply]
      simp

private theorem sd_proj_basis {N : ℕ} (b : Module.Basis (Fin N) K W) (s t : Finset (Fin N)) :
    sd_proj b s (b.ExteriorAlgebra t) = if s = t then b.ExteriorAlgebra t else 0 := by
  rw [sd_proj, sd_listProd_factor_apply]
  by_cases hst : s = t
  · subst t
    simp only [iff_self, ite_true]
    have hall : (List.ofFn fun i : Fin N ↦ i).map (fun _ ↦ (1 : K)) = List.replicate N 1 := by
      apply List.eq_replicate_iff.mpr
      simp
    rw [hall, List.prod_replicate, one_pow, one_smul]
  · have hdiff : ∃ i : Fin N, ¬ (i ∈ s ↔ i ∈ t) := by
      contrapose! hst
      exact Finset.ext hst
    obtain ⟨i, hi⟩ := hdiff
    have hzero : (0 : K) ∈ (List.ofFn fun i : Fin N ↦ i).map
        (fun i ↦ (if (i ∈ s ↔ i ∈ t) then 1 else 0 : K)) := by
      apply List.mem_map.mpr
      exact ⟨i, List.mem_ofFn.mpr ⟨i, rfl⟩, by simp [hi]⟩
    rw [ite_eq_right hst, List.prod_eq_zero hzero, zero_smul]

/-- Creation of `b_s` (left multiplication by `b_{s₁} ∧ ⋯ ∧ b_{s_k}`, `s₁ < ⋯ < s_k`). -/
private noncomputable def sd_create {N : ℕ} (b : Module.Basis (Fin N) K W) (s : Finset (Fin N)) :
    Module.End K (ExteriorAlgebra K W) :=
  List.prod ((List.ofFn fun j : Fin s.card ↦
    Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2 j).map
      fun i ↦ (LinearMap.mulLeft K ((ExteriorAlgebra.ι K) (b i)) : Module.End K _))

/-- Annihilation of `b_s` (contraction by `b_{s_k}^*, …, b_{s₁}^*`). -/
private noncomputable def sd_annihilate {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s : Finset (Fin N)) : Module.End K (ExteriorAlgebra K W) :=
  List.prod (((List.ofFn fun j : Fin s.card ↦
    Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2 j).map
      fun i ↦ (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W))
        (b.coord i) : Module.End K _)).reverse)

/-- The matrix unit `b_t ↦ b_s`. -/
private noncomputable def sd_matrixUnit {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s t : Finset (Fin N)) : Module.End K (ExteriorAlgebra K W) :=
  sd_create b s * sd_annihilate b t * sd_proj b t

private theorem sd_create_basis_empty {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s : Finset (Fin N)) : sd_create b s (b.ExteriorAlgebra ∅) = b.ExteriorAlgebra s := by
  have hEmpty : b.ExteriorAlgebra (∅ : Finset (Fin N)) = 1 := by
    rw [ExteriorAlgebra.basis_apply]
    simp
  rw [sd_create, hEmpty, ExteriorAlgebra.basis_apply]
  have hmap (xs : List (Fin N)) :
      (xs.map (fun i ↦ LinearMap.mulLeft K (ExteriorAlgebra.ι K (b i)))).prod 1 =
        (xs.map fun i ↦ ExteriorAlgebra.ι K (b i)).prod := by
    induction xs with
    | nil => simp
    | cons i xs ih => simp [ih, Module.End.mul_apply]
  rw [hmap]
  change _ = ExteriorAlgebra.ιMulti K s.card
    (b ∘ Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2)
  rw [ExteriorAlgebra.ιMulti_apply, List.map_ofFn]
  apply congrArg List.prod
  apply List.ofFn_inj.mpr
  rfl

private theorem sd_contractLeft_listProd_eq_zero {N : ℕ} (b : Module.Basis (Fin N) K W)
    (i : Fin N) (xs : List (Fin N)) (hi : i ∉ xs) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W)) (b.coord i)
      (xs.map fun j ↦ ExteriorAlgebra.ι K (b j)).prod = 0 := by
  induction xs with
  | nil => exact CliffordAlgebra.contractLeft_one (Q := (0 : QuadraticForm K W)) (b.coord i)
  | cons j xs ih =>
      rw [List.map_cons, List.prod_cons, CliffordAlgebra.contractLeft_ι_mul]
      have hij : i ≠ j := fun h => hi (by simp [h])
      have hit : i ∉ xs := fun h => hi (by simp [h])
      simp only [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
      simp only [ite_eq_right hij.symm]
      rw [zero_smul, ih hit, mul_zero, sub_zero]

private theorem sd_annihilate_listProd_self {N : ℕ} (b : Module.Basis (Fin N) K W)
    (xs : List (Fin N)) (hxs : xs.Nodup) :
    (xs.map fun i ↦ (CliffordAlgebra.contractLeft
      (Q := (0 : QuadraticForm K W)) (b.coord i) : Module.End K _)).reverse.prod
      (xs.map fun i ↦ ExteriorAlgebra.ι K (b i)).prod = 1 := by
  induction xs with
  | nil => simp
  | cons i xs ih =>
      simp only [List.map_cons, List.reverse_cons, List.prod_append, List.prod_cons,
        Module.End.mul_apply]
      change (xs.map fun i ↦ (CliffordAlgebra.contractLeft
        (Q := (0 : QuadraticForm K W)) (b.coord i) : Module.End K _)).reverse.prod
          ((CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W)) (b.coord i))
              (ExteriorAlgebra.ι K (b i) * (xs.map fun j ↦ ExteriorAlgebra.ι K (b j)).prod)) = 1
      rw [CliffordAlgebra.contractLeft_ι_mul]
      simp only [Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
      rw [sd_contractLeft_listProd_eq_zero b i xs hxs.notMem, mul_zero, sub_zero]
      simp only [ite_true, one_smul]
      rw [ih hxs.tail]

private theorem sd_annihilate_basis_self {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s : Finset (Fin N)) : sd_annihilate b s (b.ExteriorAlgebra s) = b.ExteriorAlgebra ∅ := by
  have hEmpty : b.ExteriorAlgebra (∅ : Finset (Fin N)) = 1 := by
    rw [ExteriorAlgebra.basis_apply]
    simp
  rw [sd_annihilate, ExteriorAlgebra.basis_apply, hEmpty]
  change ((List.map (fun i ↦ (CliffordAlgebra.contractLeft
      (Q := (0 : QuadraticForm K W)) (b.coord i) : Module.End K _))
      (List.ofFn fun j : Fin s.card ↦
        Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2 j)).reverse.prod)
    (ExteriorAlgebra.ιMulti K s.card
    (b ∘ Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2)) = 1
  rw [ExteriorAlgebra.ιMulti_apply]
  change ((List.ofFn fun j : Fin s.card ↦
      Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2 j).map fun i ↦
          (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W))
            (b.coord i) : Module.End K _)).reverse.prod
    ((List.ofFn fun j : Fin s.card ↦
      ExteriorAlgebra.ι K (b (Set.powersetCard.ofFinEmbEquiv.symm
        (Set.powersetCard.prodEquiv.symm s).2 j))).prod) = 1
  let xs := List.ofFn fun j : Fin s.card ↦ Set.powersetCard.ofFinEmbEquiv.symm
    (Set.powersetCard.prodEquiv.symm s).2 j
  have hxmap : xs.map (fun i ↦ ExteriorAlgebra.ι K (b i)) =
      List.ofFn (fun j : Fin s.card ↦ ExteriorAlgebra.ι K
        (b (Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2 j))) := by
    dsimp only [xs]
    rw [List.map_ofFn]
    congr 1
  rw [← hxmap]
  apply sd_annihilate_listProd_self b xs
  exact List.nodup_ofFn.mpr
    (Set.powersetCard.ofFinEmbEquiv.symm (Set.powersetCard.prodEquiv.symm s).2).injective

/-- `E_{s,t}(b_u) = δ_{t,u} b_s`. -/
private theorem sd_matrixUnit_basis {N : ℕ} (b : Module.Basis (Fin N) K W)
    (s t u : Finset (Fin N)) :
    sd_matrixUnit b s t (b.ExteriorAlgebra u) = if t = u then b.ExteriorAlgebra s else 0 := by
  rw [sd_matrixUnit, Module.End.mul_apply, Module.End.mul_apply, sd_proj_basis]
  split_ifs with h
  · subst u
    rw [sd_annihilate_basis_self, sd_create_basis_empty]
  · rw [map_zero, map_zero]

/-- The matrix units lie in every subring containing the creation and contraction operators of
the basis. -/
private theorem sd_matrixUnit_mem {N : ℕ} (b : Module.Basis (Fin N) K W)
    (R : Subring (Module.End K (ExteriorAlgebra K W)))
    (hcre : ∀ i, LinearMap.mulLeft K (ExteriorAlgebra.ι K (b i)) ∈ R)
    (hcon : ∀ i, CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm K W)) (b.coord i) ∈ R)
    (s t : Finset (Fin N)) : sd_matrixUnit b s t ∈ R := by
  have hocc : ∀ i, sd_occ b i ∈ R := fun i => by
    rw [sd_occ, ← Module.End.mul_eq_comp]
    exact mul_mem (hcre i) (hcon i)
  have hvac : ∀ i, sd_vac b i ∈ R := fun i => by
    rw [sd_vac, ← Module.End.one_eq_id]
    exact sub_mem (one_mem _) (hocc i)
  rw [sd_matrixUnit]
  refine mul_mem (mul_mem ?_ ?_) ?_
  · rw [sd_create]
    refine list_prod_mem fun g hg => ?_
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hg
    exact hcre i
  · rw [sd_annihilate]
    refine list_prod_mem fun g hg => ?_
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp (List.mem_reverse.mp hg)
    exact hcon i
  · rw [sd_proj]
    refine list_prod_mem fun g hg => ?_
    obtain ⟨i, -, rfl⟩ := List.mem_map.mp hg
    split_ifs
    · exact hocc i
    · exact hvac i

end MatrixUnits

section Integral

variable (n : ℕ)

/-- The lattice `SZ n = H*(X, ℤ)` is Tau Ceti's coordinate lattice of the basis `e_K`. -/
private theorem sd_mem_SZ_iff {s : S ℚ n} :
    s ∈ SZ n ↔ s ∈ TauCeti.ExteriorAlgebra.integralLattice (Pi.basisFun ℚ (Fin (2 * n))) := by
  rw [TauCeti.ExteriorAlgebra.mem_integralLattice_iff]
  constructor
  · intro h K
    obtain ⟨z, hz⟩ := h K
    exact ⟨z, hz.symm⟩
  · intro h K
    obtain ⟨z, hz⟩ := h K
    exact ⟨z, hz.symm⟩

/-- The endomorphisms of `S_ℚ` preserving the lattice `SZ n` (the model of `End(S)`), a subring. -/
def sd_EndZ : Subring (Module.End ℚ (S ℚ n)) where
  carrier := {A | ∀ s ∈ SZ n, A s ∈ SZ n}
  mul_mem' hA hB s hs := hA _ (hB s hs)
  one_mem' _ hs := hs
  add_mem' hA hB s hs := add_mem (hA s hs) (hB s hs)
  zero_mem' _ _ := zero_mem _
  neg_mem' hA s hs := neg_mem (hA s hs)

/-- Creation by `eᵢ` preserves `SZ n`. -/
theorem sd_mulLeft_mem (i : Fin (2 * n)) :
    LinearMap.mulLeft ℚ (ExteriorAlgebra.ι ℚ (e ℚ n i)) ∈ sd_EndZ n := by
  intro s hs
  rw [sd_mem_SZ_iff] at hs ⊢
  have h :=
    TauCeti.ExteriorAlgebra.ι_basis_mul_mem_integralLattice (Pi.basisFun ℚ (Fin (2 * n))) i hs
  rwa [Pi.basisFun_apply] at h

/-- `fᵢ` is the `i`-th coordinate of the standard basis. -/
theorem sd_coord_eq_f (i : Fin (2 * n)) : (Pi.basisFun ℚ (Fin (2 * n))).coord i = f ℚ n i := by
  ext x
  simp [f]

/-- Contraction by `fᵢ` preserves `SZ n`. -/
theorem sd_contractLeft_mem (i : Fin (2 * n)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm ℚ (H1 ℚ n))) (f ℚ n i) ∈ sd_EndZ n := by
  intro s hs
  rw [sd_mem_SZ_iff] at hs ⊢
  rw [← sd_coord_eq_f]
  exact TauCeti.ExteriorAlgebra.contractLeft_coord_mem_integralLattice _ i hs

/-- A vector of `V_ℚ` in coordinates: `(θ, w) = Σᵢ θ(eᵢ) (fᵢ, 0) + wᵢ (0, eᵢ)`. -/
theorem sd_V_eq_sum (v : V ℚ n) :
    v = ∑ i, (v.1 (e ℚ n i) • ((f ℚ n i, 0) : V ℚ n) + v.2 i • ((0, e ℚ n i) : V ℚ n)) := by
  refine Prod.ext ?_ ?_
  · rw [Prod.fst_sum]
    simp only [Prod.fst_add, Prod.smul_fst, smul_zero, add_zero]
    conv_lhs => rw [← (Pi.basisFun ℚ (Fin (2 * n))).sum_dual_apply_smul_coord v.1]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [sd_coord_eq_f, Pi.basisFun_apply]
    rfl
  · rw [Prod.snd_sum]
    simp only [Prod.snd_add, Prod.smul_snd, smul_zero, zero_add]
    ext j
    simp [e, Pi.single_apply]

/-- `m(ι(v))` preserves `SZ n` for `v ∈ VZ n`. -/
theorem sd_m_ι_mem {v : V ℚ n} (hv : v ∈ VZ n) :
    m ℚ n (CliffordAlgebra.ι (Q ℚ n) v) ∈ sd_EndZ n := by
  obtain ⟨hv₁, hv₂⟩ := hv
  rw [sd_V_eq_sum n v, map_sum, map_sum]
  refine Subring.sum_mem _ fun i _ => ?_
  rw [map_add, map_add, map_smul, map_smul, map_smul, map_smul, sd_m_ι_inl, sd_m_ι_inr]
  obtain ⟨z₁, hz₁⟩ := hv₁ i
  obtain ⟨z₂, hz₂⟩ := hv₂ i
  rw [hz₁, hz₂, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
  exact add_mem (zsmul_mem (sd_contractLeft_mem n i) z₁) (zsmul_mem (sd_mulLeft_mem n i) z₂)

/-- `m(C(V)) ⊆ End(S)`: elements of the integral Clifford algebra preserve the lattice. -/
theorem sd_CZ_le_comap : CZ n ≤ (sd_EndZ n).comap (m ℚ n).toRingHom := by
  rw [CZ, Subring.closure_le]
  rintro _ ⟨v, hv, rfl⟩
  exact sd_m_ι_mem n hv

/-- `L_{eᵢ} = m(ι(0, eᵢ))` is in `m(C(V))`. -/
theorem sd_mulLeft_mem_map (i : Fin (2 * n)) :
    LinearMap.mulLeft ℚ (ExteriorAlgebra.ι ℚ ((Pi.basisFun ℚ (Fin (2 * n))) i)) ∈
      (CZ n).map (m ℚ n).toRingHom := by
  refine ⟨CliffordAlgebra.ι (Q ℚ n) ((0, e ℚ n i) : V ℚ n), Subring.subset_closure ⟨_, ?_, rfl⟩, ?_⟩
  · refine ⟨fun j => ⟨0, by simp⟩, fun j => ?_⟩
    by_cases h : j = i
    · exact ⟨1, by simp [e, h]⟩
    · exact ⟨0, by simp [e, h]⟩
  · rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, sd_m_ι_inr, Pi.basisFun_apply]
    rfl

/-- `D_{fᵢ} = m(ι(fᵢ, 0))` is in `m(C(V))`. -/
theorem sd_contractLeft_mem_map (i : Fin (2 * n)) :
    CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm ℚ (H1 ℚ n)))
        ((Pi.basisFun ℚ (Fin (2 * n))).coord i) ∈ (CZ n).map (m ℚ n).toRingHom := by
  refine ⟨CliffordAlgebra.ι (Q ℚ n) ((f ℚ n i, 0) : V ℚ n), Subring.subset_closure ⟨_, ?_, rfl⟩, ?_⟩
  · refine ⟨fun j => ?_, fun j => ⟨0, by simp⟩⟩
    by_cases h : i = j
    · exact ⟨1, by simp [e, f, h]⟩
    · exact ⟨0, by simp [e, f, h]⟩
  · rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, sd_m_ι_inl, sd_coord_eq_f]

/-- `m(C(V)) ⊇ End(S)`: a lattice-preserving endomorphism is an integral combination of the
matrix units. -/
theorem sd_EndZ_le_map : sd_EndZ n ≤ (CZ n).map (m ℚ n).toRingHom := by
  intro A hA
  set b := Pi.basisFun ℚ (Fin (2 * n))
  have hb : ∀ L, b.ExteriorAlgebra L ∈ SZ n := fun L => by
    rw [sd_mem_SZ_iff]
    exact TauCeti.ExteriorAlgebra.basis_mem_integralLattice b L
  have hA' : A = ∑ K, ∑ L, b.ExteriorAlgebra.repr (A (b.ExteriorAlgebra L)) K •
      sd_matrixUnit b K L := by
    refine b.ExteriorAlgebra.ext fun u => ?_
    simp only [LinearMap.sum_apply, LinearMap.smul_apply, sd_matrixUnit_basis, smul_ite, smul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, ite_true]
    exact (b.ExteriorAlgebra.sum_repr _).symm
  rw [hA']
  refine Subring.sum_mem _ fun K _ => Subring.sum_mem _ fun L _ => ?_
  obtain ⟨z, hz⟩ := hA _ (hb L) K
  rw [show b.ExteriorAlgebra.repr (A (b.ExteriorAlgebra L)) K = (z : ℚ) from hz,
    Int.cast_smul_eq_zsmul]
  exact zsmul_mem (sd_matrixUnit_mem b _ (sd_mulLeft_mem_map n) (sd_contractLeft_mem_map n) K L) z

end Integral

/-- **[GLO, Prop. 3.2.1(e)]**, the integral statement used in §2.1 and in the footnote of the proof
of Lemma 2.2.6: `m : C(V) → End(S)` is an isomorphism over `ℤ`. In the model: `m` maps the integral
Clifford algebra `CZ n` bijectively onto the endomorphisms of `S_ℚ` that preserve the lattice
`SZ n = H*(X, ℤ)`.
Proof: `m(C(V)) ⊆ End(S)` (`sd_CZ_le_comap`), injectivity from the field case, and
`End(S) ⊆ m(C(V))` by the matrix units (`sd_EndZ_le_map`). -/
theorem glo_prop3_2_1_e_integral (n : ℕ) :
    Set.BijOn (m ℚ n) (CZ n : Set (C ℚ n)) {A | ∀ s ∈ SZ n, A s ∈ SZ n} := by
  refine ⟨fun x hx => sd_CZ_le_comap n hx, (glo_prop3_2_1_e_field ℚ n).1.injOn, ?_⟩
  intro A hA
  obtain ⟨x, hx, rfl⟩ := sd_EndZ_le_map n hA
  exact ⟨x, hx, rfl⟩

end WeilClasses
