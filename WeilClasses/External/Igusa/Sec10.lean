/-- The subset of `Fin 6` with characteristic bit mask `k`. -/
def sc_ofMask (k : ℕ) : Finset (Fin (2 * 3)) := Finset.univ.filter fun i => k.testBit i

/-- The coordinate of `x ∈ S` on `e_K`, `K` given by its bit mask. -/
noncomputable def sc_cm (x : S F 3) (k : ℕ) : F := (basisS F 3).repr x (sc_ofMask k)

