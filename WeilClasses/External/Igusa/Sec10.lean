/-- **[Igusa, Prop. 3]**: the quartic `J` of (10.1.1) is `Spin(V_F)`-invariant on `S⁺_F`, for every
field `F` of characteristic zero (Igusa works with the algebraic group; `J` has rational
coefficients). Stated in §10.1 (l. 9642). The proofs of §10 use it in two places: the proof of
Lemma 10.2.1, l. 9795 (`J(h(α + 2β[pt_X])) = J(α + 2β[pt_X]) ≤ 0` for `h ∈ Spin(V_ℚ)`,
`WeilClasses.s10_not_fixed_lines`), and the claim of Remark 10.1.2(2), l. 9755, that the even spinor
variety lies in the singular locus of `V(J)` (`WeilClasses.s10_singular`). (The reduction to one
element per fiber of `J` in the proof of Lemma 10.1.1, l. 9702, and the normal form in the proof of
Lemma 10.2.1, l. 9792, go through the normal form instead, `igusa_prop3_normalForm_general`.) -/
theorem igusa_prop3_invariant (F : Type*) [Field F] [CharZero F] (g : Spin F 3) (x : S F 3)
    : J F (m F 3 (g : C F 3) x) = J F x := by
  -- the elements of `Spin(V_F)` preserving `J` form a subgroup, which contains the generators
  -- of `Spin(V_F)` (`sc_closure_genSet_eq_top`): `J` is invariant under each generator by an
  -- explicit polynomial identity in the coordinates (`sc_J_xp_all`, `sc_J_wp_all`, `sc_J_xl_all`,
  -- `sc_J_hd`)
  let G' : Subgroup (Spin F 3) :=
    { carrier := {g | ∀ y : S F 3, J F (m F 3 (g : C F 3) y) = J F y}
      one_mem' := fun y => by simp
      mul_mem' := fun {a b} ha hb y => by rw [Set.mem_ofPred_eq] at *; rw [sc_m_mul, ha, hb]
      inv_mem' := fun {a} ha y => by
        rw [Set.mem_ofPred_eq] at *
        have h := ha (m F 3 ((a⁻¹ : Spin F 3) : C F 3) y)
        have hy : m F 3 (a : C F 3) (m F 3 ((a⁻¹ : Spin F 3) : C F 3) y) = y := by
          have := fnd_m_inv_m F 3 a⁻¹ y
          rwa [inv_inv] at this
        rw [hy] at h
        exact h.symm }
  have hgen : sc_genSet F 3 (by norm_num) ⊆ G' := by
    rintro g ((((⟨i, j, t, hij, rfl⟩ | ⟨a, b, hab, rfl⟩) | ⟨i, j, hij, c, rfl⟩) |
      ⟨r, hr, rfl⟩) | hg)
    · exact fun y => sc_J_xp_all i j hij t y
    · exact fun y => sc_J_wp_all a b hab y
    · exact fun y => sc_J_xl_all i j hij c y
    · exact fun y => sc_J_hd r hr y
    · rw [Set.mem_singleton_iff] at hg
      subst hg
      intro y
      show J F (m F 3 (-1) y) = J F y
      rw [map_neg, map_one, LinearMap.neg_apply, Module.End.one_apply, ← neg_one_smul F y,
        J_smul]
      norm_num
  have hle : Subgroup.closure (sc_genSet F 3 (by norm_num)) ≤ G' :=
    (Subgroup.closure_le G').mpr hgen
  rw [sc_closure_genSet_eq_top (by norm_num)] at hle
  exact hle (Subgroup.mem_top g) x

/-- **[Igusa, Prop. 3]** (rational orbits), as a proposition, in the case not covered by the normal
form: for every subfield `F ⊆ ℂ` and every `d ∈ F` with `d ≠ 0` and `-d` not a square in `F`, the
level set `J⁻¹(d) ⊆ S⁺_F` is a single `Spin(V_F)`-orbit.

**Assumed** (a named hypothesis of `remark10_1_2_orbit`, the only result that uses it; see
`README.md`). When `-d` is a square the orbit statement follows from the normal form, which is
proved (`WeilClasses.remark10_1_2_orbit`). Otherwise the stabilizer is the special unitary group of
a hermitian form over `F(√-d)`, and the proof needs the vanishing of a Galois-cohomology
obstruction (Jacobson), which Mathlib does not have. -/
def IgusaProp3OrbitSubfield : Prop :=
  ∀ (F : Subfield ℂ) (d : F), d ≠ 0 → ¬ IsSquare (-d) → ∀ x y : S F 3, x ∈ Splus F 3 →
    y ∈ Splus F 3 → J F x = d → J F y = d → ∃ g : Spin F 3, m F 3 (g : C F 3) x = y

/-- **[Igusa, Prop. 3]** (rational orbits), as quoted in Remark 10.1.2(1) (l. 9751–9752): for every
subfield `F ⊆ ℂ` and every `d ∈ F` with `d ≠ 0`, the level set `J⁻¹(d) ⊆ S⁺_F` is a single
`Spin(V_F)`-orbit. The remark prints `d ∈ F`, which fails for `d = 0` (`remark10_1_2_orbit`).
Reading: over a non-closed `F` this combines Igusa's description of the orbit over `ℂ` with the
normal form of his last paragraph: the stabilizer of a point of `J⁻¹(d)` is `SL₆` when `-d` is a
square in `F`, and otherwise the special unitary group of a hermitian form over `F(√-d)` whose
trace form is `(V_F, (·,·)_V)`, so the Galois-cohomological obstruction vanishes (Jacobson). Not
used in any other proof. Stated here for `-d` not a square in `F`, the case that the normal form
does not cover (see `IgusaProp3OrbitSubfield`). -/
theorem igusa_prop3_orbit_subfield (hOrbit : IgusaProp3OrbitSubfield) (F : Subfield ℂ) (d : F)
    (hd : d ≠ 0) (hsq : ¬ IsSquare (-d)) (x y : S F 3) (hx : x ∈ Splus F 3) (hy : y ∈ Splus F 3)
    (hxd : J F x = d) (hyd : J F y = d) : ∃ g : Spin F 3, m F 3 (g : C F 3) x = y :=
  hOrbit F d hd hsq x y hx hy hxd hyd

/-- **[Igusa, Lemma 2]**, in the case used in the proof of Lemma 10.1.1 (l. 9708–9709): for
`c ∈ ℂ`, `c ≠ 0`, the homomorphism `ρ` maps the stabilizer `Spin(V_ℂ)_w` of `w = 1 + c [pt_X]`
onto the image (`WeilClasses.slImage`) of the embedding `e : SL(W₁) → SO(V_ℂ)` of (10.1.2), where
`W₁ = ker m_1 = H¹(X̂, ℂ)` (the summand `H¹(X, ℂ)* × 0` of `V_ℂ`) and
`W₂ = ker m_{[pt_X]} = H¹(X, ℂ)` (the summand `0 × H¹(X, ℂ)`). (The injectivity of `ρ` on the
stabilizer is proved in the paper; see `lemma10_1_1_stabilizer`.) -/
theorem igusa_lemma2 (c : ℂ) (hc : c ≠ 0) :
    rho ℂ 3 '' (spinStab ℂ 3 (1 + c • pt ℂ 3) : Set (Spin ℂ 3)) =
      slImage ℂ 3 ((⊤ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊥)
        ((⊥ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊤) := by
  have hW₁ : ann ℂ 3 1 = (⊤ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊥ := by
    ext v
    rw [sc_mem_ann_one, Submodule.mem_prod]
    simp
  have hW₂ : ann ℂ 3 (pt ℂ 3) = (⊥ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊤ := by
    ext v
    rw [sc_mem_ann_pt, Submodule.mem_prod]
    simp
  rw [← hW₁, ← hW₂]
  -- the stabilizer of `1 + c [pt_X]` is the pointwise stabilizer of `1` and `[pt_X]` (`n = 3` odd)
  have hstab : ∀ g : Spin ℂ 3, g ∈ spinStab ℂ 3 (1 + c • pt ℂ 3) ↔
      m ℂ 3 (g : C ℂ 3) 1 = 1 ∧ m ℂ 3 (g : C ℂ 3) (pt ℂ 3) = pt ℂ 3 := by
    intro g
    have h := igusa_lemma2_stab_odd ℂ 3 le_rfl (by decide) 1 (pt ℂ 3) sc_isEvenPureSpinor_one
      sc_isEvenPureSpinor_pt sc_ann_one_inf_ann_pt 1 c one_ne_zero hc
    rw [one_smul] at h
    rw [mem_spinStab_iff, ← sc_mem_fixingSpin_singleton_iff, h, sc_mem_fixingSpin_pair_iff]
  have hM : mukai ℂ 3 1 (pt ℂ 3) ≠ 0 := sc_mukai_one_pt_ne_zero (by norm_num)
  ext T
  constructor
  · rintro ⟨g, hg, rfl⟩
    rw [SetLike.mem_coe, hstab] at hg
    have hg1 : g ∈ lineStabilizer ℂ 3 1 := ⟨1, by rw [hg.1, one_smul]⟩
    have hg2 : g ∈ lineStabilizer ℂ 3 (pt ℂ 3) := ⟨1, by rw [hg.2, one_smul]⟩
    refine ⟨sc_pairing_rho g, rho_mem_ann_of_mem_lineStabilizer ℂ 3 1 g hg1,
      rho_mem_ann_of_mem_lineStabilizer ℂ 3 _ g hg2, ?_⟩
    obtain ⟨c', hc', hc'2⟩ := chevalley_III_3_2_III_4_5 ℂ 3 1 sc_isEvenPureSpinor_one g
      (rho_mem_ann_of_mem_lineStabilizer ℂ 3 1 g hg1)
    rw [hg.1] at hc'
    have hc'1 : c' = 1 := by
      have h1 : (1 - c') • (1 : S ℂ 3) = 0 := by rw [sub_smul, one_smul, ← hc', sub_self]
      rw [smul_eq_zero, or_iff_left sc_one_ne_zero, sub_eq_zero] at h1
      exact h1.symm
    rw [← hc'2, hc'1, one_pow]
  · rintro ⟨hiso, h₁, h₂, hdet⟩
    have hunit : IsUnit ((T : V ℂ 3 →ₗ[ℂ] V ℂ 3).restrict h₁) := by
      rw [LinearMap.isUnit_iff_isUnit_det, hdet]
      exact isUnit_one
    obtain ⟨g, hgA⟩ : hunit.unit ∈ (pairRestrict ℂ 3 1 (pt ℂ 3)).range := by
      have := igusa_lemma1_range ℂ 3 1 (pt ℂ 3) sc_isEvenPureSpinor_one sc_isEvenPureSpinor_pt
        sc_ann_one_inf_ann_pt
      have hmem : hunit.unit ∈ ({A : (Module.End ℂ (ann ℂ 3 1))ˣ |
          IsSquare (LinearMap.det (A : Module.End ℂ (ann ℂ 3 1)))} :
            Set (Module.End ℂ (ann ℂ 3 1))ˣ) := by
        show IsSquare (LinearMap.det ((T : V ℂ 3 →ₗ[ℂ] V ℂ 3).restrict h₁))
        rw [hdet]
        exact ⟨1, (one_mul 1).symm⟩
      rw [← this] at hmem
      exact hmem
    -- `ρ(g) = T` on `W₁`
    have hgW₁ : ∀ x ∈ ann ℂ 3 1, rho ℂ 3 g x = T x := by
      intro x hx
      have := congrArg (fun A : (Module.End ℂ (ann ℂ 3 1))ˣ =>
        (((A : Module.End ℂ (ann ℂ 3 1)) ⟨x, hx⟩ : ann ℂ 3 1) : V ℂ 3)) hgA
      simpa only [sc_pairRestrict_apply, IsUnit.unit_spec, LinearMap.coe_restrict_apply,
        LinearEquiv.coe_coe] using this
    -- `T` is onto `W₁`
    have hsurj : ∀ x ∈ ann ℂ 3 1, ∃ x' ∈ ann ℂ 3 1, T x' = x := by
      intro x hx
      obtain ⟨x', hx'⟩ := ((Module.End.isUnit_iff _).mp hunit).2 ⟨x, hx⟩
      refine ⟨x', x'.2, ?_⟩
      have := congrArg Subtype.val hx'
      simpa only [LinearMap.coe_restrict_apply, LinearEquiv.coe_coe] using this
    have hC := sc_isCompl sc_isEvenPureSpinor_one.2 (sc_isEvenPureSpinor_pt (F := ℂ) (n := 3)).2
      sc_ann_one_inf_ann_pt
    have hg₂ : (g : Spin ℂ 3) ∈ lineStabilizer ℂ 3 (pt ℂ 3) := (Subgroup.mem_inf.mp g.2).2
    have hg₁ : (g : Spin ℂ 3) ∈ lineStabilizer ℂ 3 1 := (Subgroup.mem_inf.mp g.2).1
    -- `ρ(g) = T` on `W₂` (both are isometries agreeing on `W₁`)
    have hgW₂ : ∀ y ∈ ann ℂ 3 (pt ℂ 3), rho ℂ 3 g y = T y := by
      intro y hy
      rw [← sub_eq_zero]
      apply sc_eq_zero_of_mem_of_orth hC (sc_isEvenPureSpinor_pt (F := ℂ) (n := 3)).2
        (Submodule.sub_mem _ (rho_mem_ann_of_mem_lineStabilizer ℂ 3 _ g hg₂ y hy) (h₂ y hy))
      intro x hx
      obtain ⟨x', hx', rfl⟩ := hsurj x hx
      rw [map_sub, ← hgW₁ x' hx', sc_pairing_rho, ← hiso x' y, hgW₁ x' hx', sub_self]
    have hρT : rho ℂ 3 g = T := by
      apply LinearEquiv.ext
      intro v
      obtain ⟨x, hx, y, hy, rfl⟩ :=
        Submodule.mem_sup.mp (hC.sup_eq_top ▸ Submodule.mem_top (x := v))
      rw [map_add, map_add, hgW₁ x hx, hgW₂ y hy]
    -- the scalars by which `g` acts on `1` and `[pt_X]`
    obtain ⟨c₁, hc₁, hc₁2⟩ := chevalley_III_3_2_III_4_5 ℂ 3 1 sc_isEvenPureSpinor_one g
      (rho_mem_ann_of_mem_lineStabilizer ℂ 3 1 g hg₁)
    obtain ⟨c₂, hc₂, -⟩ := chevalley_III_3_2_III_4_5 ℂ 3 (pt ℂ 3) sc_isEvenPureSpinor_pt g
      (rho_mem_ann_of_mem_lineStabilizer ℂ 3 _ g hg₂)
    subst hρT
    rw [show LinearMap.det ((rho ℂ 3 g : V ℂ 3 →ₗ[ℂ] V ℂ 3).restrict
        (rho_mem_ann_of_mem_lineStabilizer ℂ 3 1 g hg₁)) = 1 from hdet] at hc₁2
    have hc12 : c₁ * c₂ = 1 := by
      have h := sc_mukai_m_spin (g : Spin ℂ 3) 1 (pt ℂ 3)
      rw [hc₁, hc₂] at h
      simp only [map_smul, LinearMap.smul_apply, smul_eq_mul] at h
      exact mul_right_cancel₀ hM (by linear_combination h)
    have hsq : c₁ ^ 2 = 1 ^ 2 := by rw [hc₁2, one_pow]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h1 | h1
    · have h2 : c₂ = 1 := by rw [h1, one_mul] at hc12; exact hc12
      exact ⟨g, (hstab g).mpr ⟨by rw [hc₁, h1, one_smul], by rw [hc₂, h2, one_smul]⟩, rfl⟩
    · have h2 : c₂ = -1 := by
        rw [h1] at hc12
        linear_combination -hc12
      refine ⟨⟨-1, sc_neg_one_mem (by norm_num)⟩ * g, (hstab _).mpr ⟨?_, ?_⟩, ?_⟩
      · rw [sc_m_mul, hc₁, h1]
        simp
      · rw [sc_m_mul, hc₂, h2]
        simp
      · apply LinearEquiv.ext
        intro v
        rw [sc_rho_mul, (sc_rho_eq_id_iff _).mpr (Or.inr rfl)]

end WeilClasses
