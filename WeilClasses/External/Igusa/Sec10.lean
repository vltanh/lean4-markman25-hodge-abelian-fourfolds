    c 10) * (c 54 * c 45 - c 60 * c 39 - (-c 46) * (-c 53)) + (c 5 * c 34 - c 3 * c 36 - c 33 *
    c 6) * ((-c 58) * (-c 29) - c 60 * c 27 - c 30 * c 57) + (c 5 * c 18 - c 3 * c 20 - c 17 *
    c 6) * ((-c 58) * c 45 - c 60 * (-c 43) - (-c 46) * c 57) + (c 5 * c 10 - c 3 * c 12 - c 9 *
    c 6) * ((-c 58) * (-c 53) - c 60 * c 51 - c 54 * c 57)) - (1 / 4 : F) * (c 0 * c 63 - (c 3 *
