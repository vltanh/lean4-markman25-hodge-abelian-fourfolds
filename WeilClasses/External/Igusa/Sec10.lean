theorem sc_mem_ofMask (k : ℕ) (i : Fin (2 * 3)) : i ∈ sc_ofMask k ↔ k.testBit i = true := by
  simp [sc_ofMask]

theorem sc_ofMask_xor (k a : ℕ) (ha : a < 2 * 3) :
    sc_ofMask (k ^^^ 2 ^ a) = if k.testBit a then (sc_ofMask k).erase ⟨a, ha⟩
      else insert ⟨a, ha⟩ (sc_ofMask k) := by
  ext i
  split_ifs with h
  · simp only [sc_mem_ofMask, Finset.mem_erase, Nat.testBit_xor, Nat.testBit_two_pow]
    by_cases hi : (i : ℕ) = a
    · have : i = ⟨a, ha⟩ := Fin.ext hi
      subst this
      simp [h]
    · have : i ≠ ⟨a, ha⟩ := fun h' => hi (by rw [h'])
      simp [this, Ne.symm hi]
  · simp only [sc_mem_ofMask, Finset.mem_insert, Nat.testBit_xor, Nat.testBit_two_pow]
    by_cases hi : (i : ℕ) = a
    · have : i = ⟨a, ha⟩ := Fin.ext hi
      subst this
      simp [h]
    · have : i ≠ ⟨a, ha⟩ := fun h' => hi (by rw [h'])
      simp [this, Ne.symm hi]

/-- The sign `(-1)^{#{i ∈ K : i < a}}`, `K` given by its bit mask. -/
noncomputable def sc_sgn (k a : ℕ) : F :=
  if Even ((sc_ofMask k).filter fun i : Fin (2 * 3) => (i : ℕ) < a).card then 1 else -1

theorem sc_neg_one_pow_card (k a : ℕ) :
    (-1 : F) ^ ((sc_ofMask k).filter fun i : Fin (2 * 3) => (i : ℕ) < a).card = sc_sgn k a := by
  unfold sc_sgn
  split_ifs with h
  · exact h.neg_one_pow
  · exact (Nat.not_even_iff_odd.mp h).neg_one_pow

theorem sc_filter_lt_eq (K : Finset (Fin (2 * 3))) (a : ℕ) (ha : a < 2 * 3) :
    K.filter (· < (⟨a, ha⟩ : Fin (2 * 3))) = K.filter fun i : Fin (2 * 3) => (i : ℕ) < a := by
  ext i
  simp [Fin.lt_def]

theorem sc_cm_ι_e (k a : ℕ) (ha : a < 2 * 3) (w : S F 3) :
    sc_cm (ExteriorAlgebra.ι F (e F 3 ⟨a, ha⟩) * w) k =
      if k.testBit a then sc_sgn (k ^^^ 2 ^ a) a * sc_cm w (k ^^^ 2 ^ a) else 0 := by
  unfold sc_cm
  rw [sc_repr_ι_e_mul_gen]
  by_cases h : k.testBit a = true
  · have hm : (⟨a, ha⟩ : Fin (2 * 3)) ∈ sc_ofMask k := (sc_mem_ofMask k _).mpr h
    have hx : sc_ofMask (k ^^^ 2 ^ a) = (sc_ofMask k).erase ⟨a, ha⟩ := by
      rw [sc_ofMask_xor k a ha, ite_eq_left h]
    rw [ite_eq_left hm, ite_eq_left h, ← sc_neg_one_pow_card, hx, sc_filter_lt_eq]
  · have hm : (⟨a, ha⟩ : Fin (2 * 3)) ∉ sc_ofMask k := fun hm => h ((sc_mem_ofMask k _).mp hm)
    rw [ite_eq_right hm, ite_eq_right h]

theorem sc_cm_D_f (k a : ℕ) (ha : a < 2 * 3) (w : S F 3) :
    sc_cm (D F 3 (f F 3 ⟨a, ha⟩) w) k =
      if k.testBit a then 0 else sc_sgn k a * sc_cm w (k ^^^ 2 ^ a) := by
  unfold sc_cm
  rw [sc_repr_D_f_gen]
  by_cases h : k.testBit a = true
  · have hm : (⟨a, ha⟩ : Fin (2 * 3)) ∈ sc_ofMask k := (sc_mem_ofMask k _).mpr h
    rw [ite_eq_left hm, ite_eq_left h]
  · have hm : (⟨a, ha⟩ : Fin (2 * 3)) ∉ sc_ofMask k := fun hm => h ((sc_mem_ofMask k _).mp hm)
    have hx : sc_ofMask (k ^^^ 2 ^ a) = insert ⟨a, ha⟩ (sc_ofMask k) := by
      rw [sc_ofMask_xor k a ha, ite_eq_right h]
    rw [ite_eq_right hm, ite_eq_right h, ← sc_neg_one_pow_card, hx, sc_filter_lt_eq]

theorem sc_cm_ι_e' (k : ℕ) (i : Fin (2 * 3)) (w : S F 3) :
    sc_cm (ExteriorAlgebra.ι F (e F 3 i) * w) k =
      if k.testBit i then sc_sgn (k ^^^ 2 ^ (i : ℕ)) i * sc_cm w (k ^^^ 2 ^ (i : ℕ)) else 0 :=
  sc_cm_ι_e k i i.2 w

theorem sc_cm_D_f' (k : ℕ) (i : Fin (2 * 3)) (w : S F 3) :
    sc_cm (D F 3 (f F 3 i) w) k =
      if k.testBit i then 0 else sc_sgn k i * sc_cm w (k ^^^ 2 ^ (i : ℕ)) :=
  sc_cm_D_f k i i.2 w

