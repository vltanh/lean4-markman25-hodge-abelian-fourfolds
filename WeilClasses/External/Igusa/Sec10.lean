module

public import WeilClasses.Igusa.Defs
public import WeilClasses.Spinor.Integral
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.Algebra.Polynomial.Eval.Defs

/-!
# Results of Igusa (1970) used in §10 of the paper

J.-I. Igusa, *A classification of spinors up to dimension twelve*, Amer. J. Math. **92** (1970),
no. 4, 997–1028 ([I] in the paper): Proposition 3 and Lemma 2, in the special cases quoted and used
in §10 (an abelian threefold, `dim V = 12`, the `32`-dimensional half-spin representation `S⁺`,
the invariant quartic `J` of (10.1.1), `WeilClasses.J`).

* `igusa_prop3_invariant`: `J` is `Spin(V_F)`-invariant.
* `igusa_prop3_invariants`: the `Spin(V)`-invariant polynomials on `S⁺_ℚ` are the polynomials in
  `J` (§10.1, l. 9642).
* `igusa_prop3_orbit_complex`: for `c ≠ 0`, `J⁻¹(c) ⊆ S⁺_ℂ` is one `Spin(V_ℂ)`-orbit (proof of
  Lemma 10.1.1, l. 9702).
* `igusa_prop3_orbit_subfield`: the same for `J⁻¹(d) ⊆ S⁺_F`, `F ⊆ ℂ` a subfield, `d ∈ F`, `d ≠ 0`
  (Remark 10.1.2(1), l. 9752, which prints `d ∈ F`; see `remark10_1_2_orbit`).
* `igusa_prop3_normalForm`, `igusa_prop3_normalForm_of_sq`: the normal form `1 + 2√-d [pt_X]` over
  a field containing `√-d` (last paragraph of the proof of Prop. 3; proof of Lemma 10.2.1, l. 9792).
* `igusa_lemma2`: the stabilizer of `1 + c [pt_X]`, `c ≠ 0`, maps under `ρ` onto the image of the
  embedding `e : SL(W₁) → SO(V_ℂ)` (10.1.2) for `W₁ = H¹(X̂)`, `W₂ = H¹(X)` (proof of
  Lemma 10.1.1, l. 9709).

The tangential-variety description of `V(J)` ([Abuaf, Rem. 2.1.1], §10.1, l. 9643) is not used in
any proof and is not stated.
-/

@[expose] public section

namespace WeilClasses

open CliffordAlgebra

/-- **[Igusa, Prop. 3]**: the quartic `J` of (10.1.1) is `Spin(V_F)`-invariant on `S⁺_F`, for every
field `F` of characteristic zero (Igusa works with the algebraic group; `J` has rational
coefficients). Used throughout §10: in §10.1 (l. 9642), in the proof of Lemma 10.1.1 (reduction to
one element per fiber of `J`) and in the proof of Lemma 10.2.1 (`J(g w) = J(w) = d`). -/
theorem igusa_prop3_invariant (F : Type*) [Field F] [CharZero F] (g : Spin F 3) (x : S F 3)
    (hx : x ∈ Splus F 3) : J F (m F 3 (g : C F 3) x) = J F x := by
  sorry

/-- **[Igusa, Prop. 3]**, as quoted in §10.1 (l. 9641–9642): the ring `Sym((S⁺_ℚ)*)^{Spin(V)}` of
`Spin(V)`-invariant polynomials on `S⁺_ℚ` is generated by `J`. Here `Spin(V)` is the integral spin
group (`WeilClasses.SpinZ`), as in the text; a polynomial is an element of `MvPolynomial EvenIdx ℚ`
in the `32` coordinates `evenCoords` of `S⁺_ℚ`, and (`ℚ` being infinite) invariance and the
conclusion are stated for the polynomial functions on `S⁺_ℚ`. Not used in any proof. -/
theorem igusa_prop3_invariants (p : MvPolynomial EvenIdx ℚ)
    (hp : ∀ g ∈ SpinZ 3, ∀ x ∈ Splus ℚ 3,
      MvPolynomial.eval (evenCoords ℚ (m ℚ 3 (g : C ℚ 3) x)) p =
        MvPolynomial.eval (evenCoords ℚ x) p) :
    ∃ q : Polynomial ℚ, ∀ x ∈ Splus ℚ 3, MvPolynomial.eval (evenCoords ℚ x) p = q.eval (J ℚ x) := by
  sorry

/-- **[Igusa, Prop. 3]** (orbits over `ℂ`): for `c ≠ 0` the fiber `J⁻¹(c) ⊆ S⁺_ℂ` is a single
`Spin(V_ℂ)`-orbit. Used in the proof of Lemma 10.1.1 (l. 9702: "the complement
`S⁺_ℂ ∖ Ṽ(J)` intersects each fiber of `J : S⁺_ℂ → ℂ` in a single `Spin(V_ℂ)`-orbit"). -/
theorem igusa_prop3_orbit_complex (x y : S ℂ 3) (hx : x ∈ Splus ℂ 3) (hy : y ∈ Splus ℂ 3)
    (hxy : J ℂ x = J ℂ y) (hx0 : J ℂ x ≠ 0) : ∃ g : Spin ℂ 3, m ℂ 3 (g : C ℂ 3) x = y := by
  sorry

/-- **[Igusa, Prop. 3]** (rational orbits), as quoted in Remark 10.1.2(1) (l. 9751–9752): for every
subfield `F ⊆ ℂ` and every `d ∈ F` with `d ≠ 0`, the level set `J⁻¹(d) ⊆ S⁺_F` is a single
`Spin(V_F)`-orbit. The remark prints `d ∈ F`, which fails for `d = 0` (`remark10_1_2_orbit`).
Reading: over a non-closed `F` this combines Igusa's description of the orbit over `ℂ` with the
normal form of his last paragraph: the stabilizer of a point of `J⁻¹(d)` is `SL₆` when `-d` is a
square in `F`, and otherwise the special unitary group of a hermitian form over `F(√-d)` whose
trace form is `(V_F, (·,·)_V)`, so the Galois-cohomological obstruction vanishes (Jacobson). Not
used in any other proof. -/
theorem igusa_prop3_orbit_subfield (F : Subfield ℂ) (d : F) (hd : d ≠ 0) (x y : S F 3)
    (hx : x ∈ Splus F 3) (hy : y ∈ Splus F 3) (hxd : J F x = d) (hyd : J F y = d) :
    ∃ g : Spin F 3, m F 3 (g : C F 3) x = y := by
  sorry

/-- **[Igusa, Prop. 3], last paragraph of the proof** (normal form), over any field `F` of
characteristic zero: if `w ∈ S⁺_F` and `s ∈ F`, `s ≠ 0`, satisfy `s² = -J(w)`, then some
`g ∈ Spin(V_F)` maps `w` to `1 + 2s [pt_X]` (note `J(1 + 2s [pt_X]) = -s² = J(w)`). The special
case used is `igusa_prop3_normalForm`. -/
theorem igusa_prop3_normalForm_of_sq (F : Type*) [Field F] [CharZero F] (w : S F 3)
    (hw : w ∈ Splus F 3) (s : F) (hs : s ≠ 0) (hsJ : s ^ 2 = -J F w) :
    ∃ g : Spin F 3, m F 3 (g : C F 3) w = 1 + (2 * s) • pt F 3 := by
  sorry

/-- **[Igusa, Prop. 3], last paragraph of the proof**, in the case used in the proof of
Lemma 10.2.1 (l. 9792): for `w ∈ S⁺_ℚ` with `d := J(w) > 0` and `K = ℚ(√-d)` there is
`g ∈ Spin(V_K)` with `g(w) = 1 + 2√-d [pt_X]` (with the paper's `√-d = i√d`,
`WeilClasses.Kd.sqrtNeg`). -/
theorem igusa_prop3_normalForm (w : S ℚ 3) (hw : w ∈ Splus ℚ 3) (hd : 0 < J ℚ w) :
    ∃ g : Spin (Kd (J ℚ w)) 3,
      m (Kd (J ℚ w)) 3 (g : C (Kd (J ℚ w)) 3) (bcS ℚ (Kd (J ℚ w)) 3 w) =
        1 + (2 * Kd.sqrtNeg (J ℚ w)) • pt (Kd (J ℚ w)) 3 := by
  sorry

/-- **[Igusa, Lemma 2]**, in the case used in the proof of Lemma 10.1.1 (l. 9708–9709): for
`c ∈ ℂ`, `c ≠ 0`, the homomorphism `ρ` maps the stabilizer `Spin(V_ℂ)_w` of `w = 1 + c [pt_X]`
onto the image (`WeilClasses.slImage`) of the embedding `e : SL(W₁) → SO(V_ℂ)` of (10.1.2), where
`W₁ = ker m_1 = H¹(X̂, ℂ)` (the summand `H¹(X, ℂ)* × 0` of `V_ℂ`) and
`W₂ = ker m_{[pt_X]} = H¹(X, ℂ)` (the summand `0 × H¹(X, ℂ)`). (The injectivity of `ρ` on the
stabilizer is proved in the paper; see `lemma10_1_1_stabilizer`.) -/
theorem igusa_lemma2 (c : ℂ) (hc : c ≠ 0) :
    rho ℂ 3 '' (spinStab ℂ 3 (1 + c • pt ℂ 3) : Set (Spin ℂ 3)) =
      slImage ℂ 3 ((⊤ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊥)
        ((⊥ : Submodule ℂ (Module.Dual ℂ (H1 ℂ 3))).prod ⊤) := by
  sorry

end WeilClasses
