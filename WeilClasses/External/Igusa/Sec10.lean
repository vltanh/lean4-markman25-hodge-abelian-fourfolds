/-!
# Results of Igusa (1970) used in §10 of the paper

J.-I. Igusa, *A classification of spinors up to dimension twelve*, Amer. J. Math. **92** (1970),
no. 4, 997–1028 ([I] in the paper): Proposition 3 and Lemma 2, in the special cases quoted and used
in §10 (an abelian threefold, `dim V = 12`, the `32`-dimensional half-spin representation `S⁺`,
the invariant quartic `J` of (10.1.1), `WeilClasses.J`).

* `igusa_prop3_invariant`: `J` is `Spin(V_F)`-invariant (proved).
* `igusa_prop3_orbit_subfield`: for `J⁻¹(d) ⊆ S⁺_F`, `F ⊆ ℂ` a subfield, `d ∈ F`, `d ≠ 0`, one
  `Spin(V_F)`-orbit (Remark 10.1.2(1), l. 9752, which prints `d ∈ F`; see `remark10_1_2_orbit`).
  **Assumed** (`IgusaProp3OrbitSubfield`) when `-d` is not a square in `F`; the square case follows
  from the normal form.

The normal form of the last paragraph of the proof of Prop. 3 (`1 + 2s [pt_X]` for `s² = -J(w)`,
proof of Lemma 10.2.1, l. 9792) and the orbits over `ℂ` (proof of Lemma 10.1.1, l. 9702) are proved
in `WeilClasses.External.Igusa.NormalForm` (`igusa_prop3_normalForm_general`,
`igusa_prop3_orbit_complex`, `igusa_prop3_normalForm`).
* `igusa_lemma2`: the stabilizer of `1 + c [pt_X]`, `c ≠ 0`, maps under `ρ` onto the image of the
  embedding `e : SL(W₁) → SO(V_ℂ)` (10.1.2) for `W₁ = H¹(X̂)`, `W₂ = H¹(X)` (proof of
  Lemma 10.1.1, l. 9709) (proved).

The assumed part of Prop. 3 is a named hypothesis (`IgusaProp3OrbitSubfield`) of
Remark 10.1.2(1), the only result whose proof uses it: over a subfield in which `-d` is not a
square, its proof needs a Galois-cohomology argument for a special unitary group, which is beyond
this project. The paper does not use §10
for its main theorems. Not stated, because no proof uses them: that the `Spin(V)`-invariant
polynomials on `S⁺_ℚ` are the polynomials in `J` (§10.1, l. 9642, context only), and the
tangential-variety description of `V(J)` ([Abuaf, Rem. 2.1.1], §10.1, l. 9643).
-/

@[expose] public section

namespace WeilClasses

open CliffordAlgebra

/-! ## Helpers (prover SC, prefix `sc_`) -/

section SCBase

variable (F F' : Type*) [Field F] [CharZero F] [Field F'] [CharZero F'] [Algebra F F'] {n : ℕ}

omit [CharZero F] [CharZero F'] in
theorem sc_bcS_ι (w : H1 F n) :
    bcS F F' n (ExteriorAlgebra.ι F w) = ExteriorAlgebra.ι F' (bcH1 F F' n w) :=
  ExteriorAlgebra.lift_ι_apply F _ _ w

omit [CharZero F] [CharZero F'] in
/-- Change of coefficients preserves `S⁺` (as `WeilClasses.s3_bcS_Splus`). -/
theorem sc_bcS_Splus (s : S F n) (hs : s ∈ Splus F n) : bcS F F' n s ∈ Splus F' n := by
  induction s, hs using CliffordAlgebra.evenOdd_induction with
  | range_ι_pow v hv =>
    simp only [ZMod.val_zero, pow_zero] at hv
    obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hv
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply F F' (S F' n)]
    exact CliffordAlgebra.one_le_evenOdd_zero _ (Submodule.mem_one.mpr ⟨_, rfl⟩)
  | add x y hx hy ihx ihy => rw [map_add]; exact Submodule.add_mem _ ihx ihy
  | ι_mul_ι_mul m₁ m₂ x hx ih =>
    rw [map_mul, map_mul]
    erw [sc_bcS_ι F F', sc_bcS_ι F F']
    have h := SetLike.mul_mem_graded
      (CliffordAlgebra.ι_mul_ι_mem_evenOdd_zero (0 : QuadraticForm F' (H1 F' n)) (bcH1 F F' n m₁)
        (bcH1 F F' n m₂)) ih
    simp only [add_zero] at h
    exact h

end SCBase

/-! ## Helpers (prover SC): generators of `Spin(V_F)`

`Spin(V_F)` is generated by the root elements `1 + t e_i e_j` (`i < j`), the Levi elements
`1 + t f_i e_j` (`i ≠ j`), Igusa's elements `s(r) = r⁻¹ + (r - r⁻¹) f₁ e₁`, the Weyl elements
`(f_a + e_a)(f_b + e_b)` (`a < b`) and `-1` (`sc_closure_genSet_eq_top`). Proof: the Weyl elements
move `g · 1` into the big cell `{x : x_∅ ≠ 0}`, the root elements move a pure spinor of the big cell
to the line of `1`, the conjugate of this step by the long Weyl element moves `g · [pt_X]` to the
line of `[pt_X]` fixing `1`, and the stabilizer of the lines of `1` and `[pt_X]` is generated by the
Levi and Igusa elements and `-1` ([Igusa, Lemma 1], `sc_le_of_lifts`). -/

section SCGen

variable {F : Type*} [Field F] [CharZero F] {n : ℕ}

omit [CharZero F] in
/-- The coefficient of `e_K` in `e_i ∧ x`. -/
theorem sc_repr_ι_e_mul_gen (i : Fin (2 * n)) (K : Finset (Fin (2 * n))) (x : S F n) :
    (basisS F n).repr (ExteriorAlgebra.ι F (e F n i) * x) K =
      if i ∈ K then (-1 : F) ^ ((K.erase i).filter (· < i)).card * (basisS F n).repr x (K.erase i)
      else 0 := by
  split_ifs with hi
  · have := sc_repr_ι_e_mul i (K.erase i) (Finset.notMem_erase i K) x
    rwa [Finset.insert_erase hi] at this
  · have key : ((basisS F n).coord K).comp
        (LinearMap.mulLeft F (ExteriorAlgebra.ι F (e F n i))) = 0 := by
      apply (basisS F n).ext
      intro L
      simp only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearMap.zero_apply,
        Module.Basis.coord_apply, sc_ι_e_mul_basisS]
      split_ifs with hiL
      · simp
      · rw [map_smul, Module.Basis.repr_self, Finsupp.smul_apply, Finsupp.single_apply,
          ite_eq_right, smul_zero]
        rintro rfl
        exact hi (Finset.mem_insert_self _ _)
    simpa only [LinearMap.comp_apply, LinearMap.mulLeft_apply, LinearMap.zero_apply,
      Module.Basis.coord_apply] using LinearMap.congr_fun key x

omit [CharZero F] in
/-- The coefficient of `e_K` in `f_i ⌋ x`. -/
theorem sc_repr_D_f_gen (i : Fin (2 * n)) (K : Finset (Fin (2 * n))) (x : S F n) :
    (basisS F n).repr (D F n (f F n i) x) K =
      if i ∈ K then 0
      else (-1 : F) ^ (K.filter (· < i)).card * (basisS F n).repr x (insert i K) := by
  split_ifs with hi
  · have key : ((basisS F n).coord K).comp (D F n (f F n i)) = 0 := by
      apply (basisS F n).ext
      intro L
      simp only [LinearMap.comp_apply, LinearMap.zero_apply, Module.Basis.coord_apply,
        sc_D_f_basisS]
      split_ifs with hiL
      · rw [map_smul, Module.Basis.repr_self, Finsupp.smul_apply, Finsupp.single_apply,
          ite_eq_right, smul_zero]
        rintro h
        exact Finset.notMem_erase i L (h ▸ hi)
      · simp
    simpa only [LinearMap.comp_apply, LinearMap.zero_apply, Module.Basis.coord_apply] using
      LinearMap.congr_fun key x
  · have h := sc_repr_D_f i (insert i K) (Finset.mem_insert_self i K) x
    rw [Finset.erase_insert hi, Finset.filter_insert, ite_eq_right (lt_irrefl i)] at h
    exact h

omit [CharZero F] in
/-- `e_y ∧ w` has no coefficient at `K` if `w` has none at the `K ∖ {i}`, `i ∈ K`. -/
theorem sc_repr_ι_mul_eq_zero (y : H1 F n) (w : S F n) (K : Finset (Fin (2 * n)))
    (hw : ∀ i ∈ K, (basisS F n).repr w (K.erase i) = 0) :
    (basisS F n).repr (ExteriorAlgebra.ι F y * w) K = 0 := by
  have hy : y = ∑ i, y i • e F n i := by
    ext j
    simp [e, Pi.single_apply]
  rw [hy, map_sum, Finset.sum_mul, map_sum, Finsupp.finsetSum_apply]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [map_smul, smul_mul_assoc, map_smul, Finsupp.smul_apply, sc_repr_ι_e_mul_gen]
  split_ifs with hi
  · rw [hw i hi, mul_zero, smul_zero]
  · rw [smul_zero]

omit [CharZero F] in
/-- An element of `S⁺` has no coefficient on the `e_K` with `|K|` odd. -/
theorem sc_repr_eq_zero_of_mem_Splus {z : S F n} (hz : z ∈ Splus F n)
    (K : Finset (Fin (2 * n))) (hK : Odd K.card) : (basisS F n).repr z K = 0 := by
  induction z, hz using CliffordAlgebra.even_induction generalizing K with
  | algebraMap r =>
    rw [Algebra.algebraMap_eq_smul_one, map_smul, Finsupp.smul_apply,
      show (1 : S F n) = basisS F n ∅ by rw [basisS, sc_basis_empty], Module.Basis.repr_self,
      Finsupp.single_apply, ite_eq_right, smul_zero]
    rintro rfl
    simp at hK
  | add x y hx hy ihx ihy =>
    rw [map_add, Finsupp.add_apply, ihx K hK, ihy K hK, add_zero]
  | ι_mul_ι_mul m₁ m₂ x hx ih =>
    rw [mul_assoc]
    apply sc_repr_ι_mul_eq_zero
    intro i hi
    apply sc_repr_ι_mul_eq_zero
    intro j hj
    apply ih
    rw [Finset.card_erase_of_mem hj, Finset.card_erase_of_mem hi]
    have h2 : 2 ≤ K.card := by
      have := Finset.card_erase_of_mem hi
      have hpos : 0 < (K.erase i).card := Finset.card_pos.mpr ⟨j, hj⟩
      omega
    obtain ⟨k, hk⟩ := hK
    exact ⟨k - 1, by omega⟩

omit [CharZero F] in
/-- `Spin(V)` preserves `S⁺`. -/
theorem sc_m_mem_Splus (g : Spin F n) {s : S F n} (hs : s ∈ Splus F n) :
    m F n (g : C F n) s ∈ Splus F n := by
  have hg : (g : C F n) ∈ CliffordAlgebra.evenOdd (Q F n) 0 := by
    rw [← CliffordAlgebra.even_toSubmodule]
    exact spinGroup.mem_even g.2
  generalize (g : C F n) = x at hg
  induction x, hg using CliffordAlgebra.even_induction with
  | algebraMap r =>
    rw [AlgHom.commutes, Module.algebraMap_end_apply]
    exact Submodule.smul_mem _ _ hs
  | add x y hx hy ihx ihy =>
    rw [map_add, LinearMap.add_apply]
    exact Submodule.add_mem _ ihx ihy
  | ι_mul_ι_mul m₁ m₂ x hx ih =>
    rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply]
    exact m_mem_Splus_of_odd F n _ (CliffordAlgebra.ι_mem_evenOdd_one _ _) _
      (m_mem_Sminus_of_odd F n _ (CliffordAlgebra.ι_mem_evenOdd_one _ _) _ ih)

/-! ### Weyl elements -/

/-- The vector `v_a = f_a + e_a`, of norm `Q(v_a) = 1`. -/
noncomputable def sc_vW (a : Fin (2 * n)) : V F n := (f F n a, e F n a)

omit [CharZero F] in
theorem sc_Q_vW (a : Fin (2 * n)) : Q F n (sc_vW a) = 1 := by
  simp [sc_vW, f, e]

/-- The Weyl element `v_a v_b ∈ Spin(V)`. -/
noncomputable def sc_wp (a b : Fin (2 * n)) : Spin F n :=
  ⟨ι (Q F n) (sc_vW a) * ι (Q F n) (sc_vW b),
    ι_mul_ι_mem_spinGroup_of_norm_mul_norm_eq_one _ _ (by rw [sc_Q_vW, sc_Q_vW, one_mul])⟩

omit [CharZero F] in
theorem sc_m_wp (a b : Fin (2 * n)) (w : S F n) :
    m F n ((sc_wp a b : Spin F n) : C F n) w =
      m F n (ι (Q F n) (sc_vW a)) (m F n (ι (Q F n) (sc_vW b)) w) := by
  show m F n (ι (Q F n) (sc_vW a) * ι (Q F n) (sc_vW b)) w = _
  rw [map_mul, Module.End.mul_apply]

omit [CharZero F] in
theorem sc_symmDiff_singleton_of_mem {a : Fin (2 * n)} {L : Finset (Fin (2 * n))} (h : a ∈ L) :
    symmDiff L {a} = L.erase a := by
  ext x
  simp only [Finset.mem_symmDiff, Finset.mem_singleton, Finset.mem_erase]
  constructor
  · rintro (⟨hx, hxa⟩ | ⟨rfl, hx⟩)
    · exact ⟨hxa, hx⟩
    · exact absurd h hx
  · rintro ⟨hxa, hx⟩
    exact Or.inl ⟨hx, hxa⟩

omit [CharZero F] in
theorem sc_symmDiff_singleton_of_notMem {a : Fin (2 * n)} {L : Finset (Fin (2 * n))}
    (h : a ∉ L) : symmDiff L {a} = insert a L := by
  ext x
  simp only [Finset.mem_symmDiff, Finset.mem_singleton, Finset.mem_insert]
  constructor
  · rintro (⟨hx, -⟩ | ⟨rfl, -⟩)
    · exact Or.inr hx
    · exact Or.inl rfl
  · rintro (rfl | hx)
    · exact Or.inr ⟨rfl, h⟩
    · exact Or.inl ⟨hx, fun hxa => h (hxa ▸ hx)⟩

omit [CharZero F] in
/-- `m(v_a)` maps `e_L` to `± e_{L ∆ {a}}`. -/
theorem sc_repr_m_vW (a : Fin (2 * n)) (L : Finset (Fin (2 * n))) :
    ∃ ε : F, (ε = 1 ∨ ε = -1) ∧ ∀ w : S F n,
      (basisS F n).repr (m F n (ι (Q F n) (sc_vW a)) w) L =
        ε * (basisS F n).repr w (symmDiff L {a}) := by
  by_cases ha : a ∈ L
  · refine ⟨(-1 : F) ^ ((L.erase a).filter (· < a)).card, neg_one_pow_eq_or F _, fun w => ?_⟩
    rw [sc_vW, sc_m_ι, map_add, Finsupp.add_apply, sc_repr_ι_e_mul_gen, sc_repr_D_f_gen,
      ite_eq_left ha, ite_eq_left ha, add_zero, sc_symmDiff_singleton_of_mem ha]
  · refine ⟨(-1 : F) ^ (L.filter (· < a)).card, neg_one_pow_eq_or F _, fun w => ?_⟩
    rw [sc_vW, sc_m_ι, map_add, Finsupp.add_apply, sc_repr_ι_e_mul_gen, sc_repr_D_f_gen,
      ite_eq_right ha, ite_eq_right ha, zero_add, sc_symmDiff_singleton_of_notMem ha]

/-- The Weyl generators `v_a v_b`, `a < b`. -/
def sc_weylSet (F : Type*) [Field F] [CharZero F] (n : ℕ) : Set (Spin F n) :=
  {g | ∃ a b : Fin (2 * n), a < b ∧ g = sc_wp a b}

omit [CharZero F] in
theorem sc_singleton_symmDiff_of_notMem {a : Fin (2 * n)} {L : Finset (Fin (2 * n))}
    (h : a ∉ L) : symmDiff {a} L = insert a L := by
  rw [symmDiff_comm, sc_symmDiff_singleton_of_notMem h]

/-- For `|K|` even, a product of Weyl generators maps every `e_L` to `± e_{L ∆ K}`. -/
theorem sc_weyl (K : Finset (Fin (2 * n))) (hK : Even K.card) :
    ∃ s ∈ Subgroup.closure (sc_weylSet F n), ∀ L : Finset (Fin (2 * n)), ∃ ε : F,
      (ε = 1 ∨ ε = -1) ∧ ∀ z : S F n,
        (basisS F n).repr (m F n (s : C F n) z) L = ε * (basisS F n).repr z (symmDiff L K) := by
  induction hc : K.card using Nat.strong_induction_on generalizing K with
  | _ c ih =>
  rcases Finset.eq_empty_or_nonempty K with rfl | hne
  · refine ⟨1, Subgroup.one_mem _, fun L => ⟨1, Or.inl rfl, fun z => ?_⟩⟩
    rw [← Finset.bot_eq_empty, symmDiff_bot]
    simp
  · set a := K.min' hne with ha
    have haK : a ∈ K := K.min'_mem hne
    have hne1 : (K.erase a).Nonempty := by
      rw [← Finset.card_pos, Finset.card_erase_of_mem haK]
      obtain ⟨k, hk⟩ := hK
      have : 0 < K.card := Finset.card_pos.mpr hne
      omega
    set b := (K.erase a).min' hne1 with hb
    have hbK : b ∈ K.erase a := (K.erase a).min'_mem hne1
    have hab : a < b := by
      have hb' : b ∈ K := Finset.mem_of_mem_erase hbK
      have hba : b ≠ a := Finset.ne_of_mem_erase hbK
      exact lt_of_le_of_ne (K.min'_le b hb') (Ne.symm hba)
    set K' := (K.erase a).erase b with hK'
    have hcard : K'.card = c - 2 := by
      rw [hK', Finset.card_erase_of_mem hbK, Finset.card_erase_of_mem haK, hc]
      omega
    have hc2 : 2 ≤ c := by
      rw [← hc, ← Finset.card_erase_add_one haK, ← Finset.card_erase_add_one hbK]
      omega
    obtain ⟨s', hs', hs'L⟩ := ih (c - 2) (by omega) K' (by
      rw [hcard]; obtain ⟨k, hk⟩ := hK; exact ⟨k - 1, by omega⟩) hcard
    refine ⟨sc_wp a b * s', Subgroup.mul_mem _ (Subgroup.subset_closure ⟨a, b, hab, rfl⟩) hs',
      fun L => ?_⟩
    obtain ⟨εa, hεa, ha'⟩ := sc_repr_m_vW (F := F) a L
    obtain ⟨εb, hεb, hb'⟩ := sc_repr_m_vW (F := F) b (symmDiff L {a})
    obtain ⟨ε', hε', h'⟩ := hs'L (symmDiff (symmDiff L {a}) {b})
    refine ⟨εa * εb * ε', ?_, fun z => ?_⟩
    · rcases hεa with rfl | rfl <;> rcases hεb with rfl | rfl <;> rcases hε' with rfl | rfl <;>
        norm_num
    · rw [sc_m_mul, sc_m_wp, ha', hb', h', ← mul_assoc, ← mul_assoc]
      congr 2
      -- `((L ∆ {a}) ∆ {b}) ∆ K' = L ∆ K`
      have hbK' : b ∉ K' := Finset.notMem_erase b _
      have haK' : a ∉ insert b K' := by
        rw [Finset.mem_insert, not_or]
        exact ⟨hab.ne, fun h => Finset.notMem_erase a K (Finset.mem_of_mem_erase h)⟩
      rw [symmDiff_assoc, symmDiff_assoc, sc_singleton_symmDiff_of_notMem hbK',
        sc_singleton_symmDiff_of_notMem haK', hK', Finset.insert_erase hbK,
        Finset.insert_erase haK]

/-- For `0 ≠ z ∈ S⁺`, a product of Weyl generators moves `z` into the big cell `z_∅ ≠ 0`. -/
theorem sc_exists_weyl_ne (z : S F n) (hz : z ∈ Splus F n) (hz0 : z ≠ 0) :
    ∃ s ∈ Subgroup.closure (sc_weylSet F n),
      (basisS F n).repr (m F n (s : C F n) z) ∅ ≠ 0 := by
  obtain ⟨K, hK⟩ : ∃ K, (basisS F n).repr z K ≠ 0 := by
    by_contra h
    push Not at h
    exact hz0 ((basisS F n).repr.injective (by ext K; simp [h K]))
  have hKe : Even K.card := by
    by_contra hodd
    exact hK (sc_repr_eq_zero_of_mem_Splus hz K (Nat.not_even_iff_odd.mp hodd))
  obtain ⟨s, hs, hsL⟩ := sc_weyl (F := F) K hKe
  obtain ⟨ε, hε, hεz⟩ := hsL ∅
  refine ⟨s, hs, ?_⟩
  rw [hεz, ← Finset.bot_eq_empty, bot_symmDiff]
  rcases hε with rfl | rfl
  · rwa [one_mul]
  · rwa [neg_one_mul, neg_ne_zero]

/-! ### Root elements `1 + t e_i e_j` and the big cell -/

omit [CharZero F] in
theorem sc_Q_E (y : H1 F n) : Q F n ((0, y) : V F n) = 0 := by simp

omit [CharZero F] in
theorem sc_polar_E_E (y y' : H1 F n) :
    QuadraticMap.polar (Q F n) ((0, y) : V F n) (0, y') = 0 := by
  rw [TauCeti.polar_dualProd]; simp

/-- The root element `x⁺_{ij}(t) = 1 + t e_i e_j` (the Spin lift of an Eichler transvection). -/
noncomputable def sc_xp (i j : Fin (2 * n)) (t : F) : Spin F n :=
  spinTransvection sc_Q_nondegenerate (sc_Q_E (e F n j)) (sc_polar_E_E (e F n j) (t • e F n i))

theorem sc_m_xp (i j : Fin (2 * n)) (t : F) (w : S F n) :
    m F n ((sc_xp i j t : Spin F n) : C F n) w =
      w + t • (ExteriorAlgebra.ι F (e F n i) * (ExteriorAlgebra.ι F (e F n j) * w)) := by
  rw [sc_xp, coe_spinTransvection, map_add, map_one, map_mul, LinearMap.add_apply,
    Module.End.one_apply, Module.End.mul_apply, sc_m_ι, sc_m_ι]
  simp only [map_zero, LinearMap.zero_apply, add_zero, map_smul, smul_mul_assoc]

/-- The root generators `x⁺_{ij}(t)`, `i < j`. -/
def sc_xpSet (F : Type*) [Field F] [CharZero F] (n : ℕ) : Set (Spin F n) :=
  {g | ∃ (i j : Fin (2 * n)) (t : F), i < j ∧ g = sc_xp i j t}

omit [CharZero F] in
/-- In degrees `≤ 2`, `e_i ∧ e_j ∧ w` (`i < j`) is `w_∅ e_{ij}`. -/
theorem sc_repr_xp_low {i j : Fin (2 * n)} (hij : i < j) (w : S F n) (K : Finset (Fin (2 * n)))
    (hK : K.card ≤ 2) :
    (basisS F n).repr (ExteriorAlgebra.ι F (e F n i) * (ExteriorAlgebra.ι F (e F n j) * w)) K =
      if K = {i, j} then (basisS F n).repr w ∅ else 0 := by
  rw [sc_repr_ι_e_mul_gen, sc_repr_ι_e_mul_gen]
  by_cases hKeq : K = {i, j}
  · subst hKeq
    have h1 : ({i, j} : Finset (Fin (2 * n))).erase i = {j} :=
      Finset.erase_insert (by simpa using hij.ne)
    have h2 : ({j} : Finset (Fin (2 * n))).filter (· < i) = ∅ := by
      rw [Finset.filter_singleton, ite_eq_right (not_lt.mpr hij.le)]
    rw [ite_eq_left (Finset.mem_insert_self _ _), h1, ite_eq_left (Finset.mem_singleton_self j),
      Finset.erase_singleton, ite_eq_left rfl, h2]
    simp
  · rw [ite_eq_right hKeq]
    split_ifs with hi hj
    · exfalso
      apply hKeq
      apply (Finset.eq_of_subset_of_card_le _ _).symm
      · intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx
        · exact hi
        · rw [Finset.mem_singleton] at hx
          subst hx
          exact Finset.mem_of_mem_erase hj
      · rw [Finset.card_pair hij.ne]
        exact hK
    · simp
    · rfl

/-- Root elements can kill the degree-`2` coefficients of a spinor with `z_∅ ≠ 0`. -/
theorem sc_bigcell_aux (z : S F n) (hz : (basisS F n).repr z ∅ ≠ 0)
    (P : Finset (Finset (Fin (2 * n)))) (hP : ∀ K ∈ P, K.card = 2) :
    ∃ u ∈ Subgroup.closure (sc_xpSet F n),
      (basisS F n).repr (m F n (u : C F n) z) ∅ = (basisS F n).repr z ∅ ∧
      (∀ K ∈ P, (basisS F n).repr (m F n (u : C F n) z) K = 0) ∧
      (∀ K : Finset (Fin (2 * n)), K.card = 2 → K ∉ P →
        (basisS F n).repr (m F n (u : C F n) z) K = (basisS F n).repr z K) := by
  induction P using Finset.induction_on with
  | empty =>
    refine ⟨1, Subgroup.one_mem _, by simp, by simp, fun K _ _ => by simp⟩
  | insert K₀ P hK₀ ih =>
    obtain ⟨u, hu, h0, hP', hrest⟩ := ih (fun K hK => hP K (Finset.mem_insert_of_mem hK))
    have hK₀2 : K₀.card = 2 := hP K₀ (Finset.mem_insert_self _ _)
    obtain ⟨i, j, hij, rfl⟩ : ∃ i j : Fin (2 * n), i < j ∧ K₀ = {i, j} := by
      obtain ⟨x, y, hxy, rfl⟩ := Finset.card_eq_two.mp hK₀2
      rcases lt_or_gt_of_ne hxy with h | h
      · exact ⟨x, y, h, rfl⟩
      · exact ⟨y, x, h, Finset.pair_comm x y⟩
    set w := m F n (u : C F n) z with hw
    have hw0 : (basisS F n).repr w ∅ ≠ 0 := by rw [hw, h0]; exact hz
    set t := -(basisS F n).repr w {i, j} / (basisS F n).repr w ∅ with ht
    have hval : ∀ K : Finset (Fin (2 * n)), K.card ≤ 2 →
        (basisS F n).repr (m F n ((sc_xp i j t * u : Spin F n) : C F n) z) K =
          (basisS F n).repr w K + t * (if K = {i, j} then (basisS F n).repr w ∅ else 0) := by
      intro K hK
      rw [sc_m_mul, sc_m_xp, ← hw, map_add, map_smul, Finsupp.add_apply, Finsupp.smul_apply,
        sc_repr_xp_low hij w K hK, smul_eq_mul]
    have hne : (∅ : Finset (Fin (2 * n))) ≠ {i, j} := (Finset.insert_ne_empty _ _).symm
    refine ⟨sc_xp i j t * u, Subgroup.mul_mem _
      (Subgroup.subset_closure ⟨i, j, t, hij, rfl⟩) hu, ?_, ?_, ?_⟩
    · rw [hval ∅ (by simp), ite_eq_right hne, mul_zero, add_zero, hw, h0]
    · intro K hK
      rcases Finset.mem_insert.mp hK with rfl | hK
      · rw [hval _ hK₀2.le, ite_eq_left rfl, ht]
        field_simp
        ring
      · have hK2 := hP K (Finset.mem_insert_of_mem hK)
        have hKne : K ≠ {i, j} := fun h => hK₀ (h ▸ hK)
        rw [hval K hK2.le, ite_eq_right hKne, mul_zero, add_zero, hw, hP' K hK]
    · intro K hK2 hKP
      have hKne : K ≠ {i, j} := fun h => hKP (h ▸ Finset.mem_insert_self _ _)
      rw [hval K hK2.le, ite_eq_right hKne, mul_zero, add_zero, hw,
        hrest K hK2 (fun h => hKP (Finset.mem_insert_of_mem h))]

omit [CharZero F] in
theorem sc_repr_one (K : Finset (Fin (2 * n))) :
    (basisS F n).repr 1 K = if K = ∅ then 1 else 0 := by
  rw [show (1 : S F n) = basisS F n ∅ by rw [basisS, sc_basis_empty], Module.Basis.repr_self,
    Finsupp.single_apply]
  simp only [eq_comm]

/-- A pure spinor with `z_∅ ≠ 0` and no degree-`2` component is `z_∅ · 1` (its annihilator is a
graph over `H¹(X̂)`, and the degree-`1` coefficients of `m_v z` force it to be `H¹(X̂) × 0`;
[Chevalley, III.1.4]). -/
theorem sc_eq_smul_one_of_pure {z : S F n} (hz : IsMaxIsotropic F n (ann F n z))
    (h0 : (basisS F n).repr z ∅ ≠ 0)
    (h2 : ∀ K : Finset (Fin (2 * n)), K.card = 2 → (basisS F n).repr z K = 0) :
    z = (basisS F n).repr z ∅ • 1 := by
  have hdeg1 : ∀ (θ : Module.Dual F (H1 F n)) (y : H1 F n) (k : Fin (2 * n)),
      (basisS F n).repr (m F n (ι (Q F n) (θ, y)) z) {k} = y k * (basisS F n).repr z ∅ := by
    intro θ y k
    rw [sc_m_ι, map_add, Finsupp.add_apply]
    have hy : y = ∑ i, y i • e F n i := by
      ext l
      simp [e, Pi.single_apply]
    have hι : (basisS F n).repr (ExteriorAlgebra.ι F y * z) {k} = y k * (basisS F n).repr z ∅ := by
      rw [hy, map_sum, Finset.sum_mul, map_sum, Finsupp.finsetSum_apply,
        Finset.sum_eq_single k]
      · rw [map_smul, smul_mul_assoc, map_smul, Finsupp.smul_apply, sc_repr_ι_e_mul_gen,
          ite_eq_left (Finset.mem_singleton_self k), Finset.erase_singleton]
        simp [Pi.single_apply, e]
      · intro i _ hik
        rw [map_smul, smul_mul_assoc, map_smul, Finsupp.smul_apply, sc_repr_ι_e_mul_gen,
          ite_eq_right (by simpa using hik), smul_zero]
      · simp
    have hD : (basisS F n).repr (D F n θ z) {k} = 0 := by
      rw [fnd_dual_eq_sum n F θ, map_sum, LinearMap.sum_apply, map_sum,
        Finsupp.finsetSum_apply]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [map_smul, LinearMap.smul_apply, map_smul, Finsupp.smul_apply, sc_repr_D_f_gen]
      split_ifs with hik
      · rw [smul_zero]
      · rw [h2 _ (by rw [Finset.card_insert_of_notMem hik, Finset.card_singleton]), mul_zero,
          smul_zero]
    rw [hι, hD, add_zero]
  have hy0 : ∀ v ∈ ann F n z, v.2 = 0 := by
    intro v hv
    obtain ⟨θ, y⟩ := v
    have hv' := (sc_mem_ann_iff z _).mp hv
    funext k
    have := hdeg1 θ y k
    rw [hv', map_zero, Finsupp.zero_apply] at this
    exact (mul_eq_zero.mp this.symm).resolve_right h0
  have hinj : Function.Injective
      ((LinearMap.fst F (Module.Dual F (H1 F n)) (H1 F n)).comp (ann F n z).subtype) := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    apply Subtype.ext
    exact Prod.ext hv (hy0 v v.2)
  have hsurj : Function.Surjective
      ((LinearMap.fst F (Module.Dual F (H1 F n)) (H1 F n)).comp (ann F n z).subtype) := by
    rwa [← LinearMap.injective_iff_surjective_of_finrank_eq_finrank]
    rw [hz.2, Subspace.dual_finrank_eq, Module.finrank_fin_fun]
  have hle : ann F n 1 ≤ ann F n z := by
    intro v hv
    rw [sc_mem_ann_one] at hv
    obtain ⟨w, hw⟩ := hsurj v.1
    have hw2 := hy0 w w.2
    have : (w : V F n) = v := Prod.ext hw (by rw [hw2, hv])
    rw [← this]
    exact w.2
  have heq : ann F n z = ann F n 1 :=
    (Submodule.eq_of_le_of_finrank_eq hle (by rw [sc_finrank_ann_one, hz.2])).symm
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp
    (chevalley_III_1_4_unique F n 1 z sc_one_ne_zero sc_isEvenPureSpinor_one.2 heq)
  have hc' : c = (basisS F n).repr z ∅ := by
    rw [← hc, map_smul, Finsupp.smul_apply, sc_repr_one, ite_eq_left rfl, smul_eq_mul, mul_one]
  rw [hc'] at hc
  exact hc.symm

/-- **The big cell**: the root elements move a pure spinor `z` with `z_∅ ≠ 0` to `z_∅ · 1`. -/
theorem sc_bigcell {z : S F n} (hz : IsMaxIsotropic F n (ann F n z))
    (h0 : (basisS F n).repr z ∅ ≠ 0) :
    ∃ u ∈ Subgroup.closure (sc_xpSet F n), m F n (u : C F n) z = (basisS F n).repr z ∅ • 1 := by
  obtain ⟨u, hu, h0', hP, -⟩ := sc_bigcell_aux z h0 (Finset.univ.powersetCard 2)
    (fun K hK => (Finset.mem_powersetCard.mp hK).2)
  refine ⟨u, hu, ?_⟩
  have := sc_eq_smul_one_of_pure (sc_isMaxIsotropic_m u hz) (by rw [h0']; exact h0)
    (fun K hK => hP K (Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, hK⟩))
  rw [this, h0']

/-- The root elements fix `[pt_X]`. -/
theorem sc_xp_fix_pt (u : Spin F n) (hu : u ∈ Subgroup.closure (sc_xpSet F n)) :
    m F n (u : C F n) (pt F n) = pt F n := by
  induction hu using Subgroup.closure_induction with
  | mem g hg =>
    obtain ⟨i, j, t, -, rfl⟩ := hg
    rw [sc_m_xp, sc_ι_mul_pt, mul_zero, smul_zero, add_zero]
  | one => simp
  | mul g h _ _ hg hh => rw [sc_m_mul, hh, hg]
  | inv g _ hg =>
    conv_lhs => rw [← hg]
    exact fnd_m_inv_m F n g _

/-! ### The second spinor: the top coefficient, the long Weyl element -/

omit [CharZero F] in
/-- `(1, y)_S = ∫_X y` is the coefficient of `[pt_X]` in `y`. -/
theorem sc_mukai_one (y : S F n) : mukai F n 1 y = (basisS F n).repr y Finset.univ := by
  simp only [mukai, LinearMap.compr₂_apply, LinearMap.comp_apply, LinearMap.mul_apply', tau,
    CliffordAlgebra.reverse.map_one, one_mul, integral, Module.Basis.coord_apply]

/-- If `h` stabilizes the line of `1`, then `h · [pt_X]` has a nonzero top coefficient
([Chevalley, III.2.4]: `(1, h [pt_X])_S ≠ 0` as `ker m_1 ∩ ker m_{h [pt_X]} = 0`). -/
theorem sc_top_ne_zero (hn : 0 < n) (h : Spin F n) (hh : h ∈ lineStabilizer F n 1) :
    (basisS F n).repr (m F n (h : C F n) (pt F n)) Finset.univ ≠ 0 := by
  obtain ⟨c, hc⟩ := hh
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [zero_smul] at hc
    exact sc_one_ne_zero (sc_m_injective h (by rw [hc, map_zero]))
  have hy : IsEvenPureSpinor F n (m F n (h : C F n) (pt F n)) :=
    ⟨sc_m_mem_Splus h sc_pt_mem_Splus, sc_isMaxIsotropic_m h sc_isEvenPureSpinor_pt.2⟩
  rw [← sc_mukai_one]
  intro hM
  apply (chevalley_III_2_4 F n hn 1 _ sc_isEvenPureSpinor_one hy).mp hM
  have h1 : ann F n 1 = (ann F n 1).map (rho F n h).toLinearMap := by
    rw [← ann_m_spin, hc, sc_ann_smul _ hc0]
  rw [h1, ann_m_spin, ← Submodule.map_inf _ (rho F n h).injective, sc_ann_one_inf_ann_pt,
    Submodule.map_bot]

/-- The long Weyl element `s` (a product of Weyl generators): `s [pt_X] = ε₀ 1`, `s 1 = ε₁ [pt_X]`,
and `(s y)_∅ = ε₀ y_{top}`. -/
theorem sc_longWeyl (hn : 0 < n) :
    ∃ s ∈ Subgroup.closure (sc_weylSet F n), ∃ ε₀ ε₁ : F, ε₀ ≠ 0 ∧ ε₁ ≠ 0 ∧
      m F n (s : C F n) (pt F n) = ε₀ • 1 ∧ m F n (s : C F n) 1 = ε₁ • pt F n ∧
      ∀ y : S F n, (basisS F n).repr (m F n (s : C F n) y) ∅ =
        ε₀ * (basisS F n).repr y Finset.univ := by
  have hev : Even (Finset.univ : Finset (Fin (2 * n))).card := by
    rw [Finset.card_univ, Fintype.card_fin]; exact even_two_mul n
  obtain ⟨s, hs, hsL⟩ := sc_weyl (F := F) Finset.univ hev
  have htop : ∀ L : Finset (Fin (2 * n)), symmDiff L Finset.univ = Lᶜ := fun L => by
    rw [← Finset.top_eq_univ, symmDiff_top, hnot_eq_compl]
  have hne : (∅ : Finset (Fin (2 * n))) ≠ Finset.univ := by
    intro h
    have := congrArg Finset.card h
    rw [Finset.card_empty, Finset.card_univ, Fintype.card_fin] at this
    omega
  obtain ⟨ε₀, hε₀, h₀⟩ := hsL ∅
  obtain ⟨ε₁, hε₁, h₁⟩ := hsL Finset.univ
  have hε : ∀ ε : F, (ε = 1 ∨ ε = -1) → ε ≠ 0 := by
    rintro ε (rfl | rfl) <;> norm_num
  have hrepr_pt : ∀ K, (basisS F n).repr (pt F n) K = if K = Finset.univ then 1 else 0 := by
    intro K
    rw [pt, Module.Basis.repr_self, Finsupp.single_apply]
    simp only [eq_comm]
  refine ⟨s, hs, ε₀, ε₁, hε ε₀ hε₀, hε ε₁ hε₁, ?_, ?_, fun y => ?_⟩
  · apply (basisS F n).repr.injective
    ext L
    rw [map_smul, Finsupp.smul_apply, sc_repr_one, smul_eq_mul]
    by_cases hL0 : L = ∅
    · subst hL0
      rw [h₀, htop, hrepr_pt, Finset.compl_empty, ite_eq_left rfl, ite_eq_left rfl]
    · obtain ⟨εL, -, hL⟩ := hsL L
      rw [hL, htop, hrepr_pt, ite_eq_right (by rwa [Finset.compl_eq_univ_iff]), ite_eq_right hL0]
      simp
  · apply (basisS F n).repr.injective
    ext L
    rw [map_smul, Finsupp.smul_apply, hrepr_pt, smul_eq_mul]
    by_cases hLu : L = Finset.univ
    · subst hLu
      rw [h₁, htop, sc_repr_one, Finset.compl_univ, ite_eq_left rfl, ite_eq_left rfl]
    · obtain ⟨εL, -, hL⟩ := hsL L
      rw [hL, htop, sc_repr_one, ite_eq_right (by rwa [Finset.compl_eq_empty_iff]),
        ite_eq_right hLu]
      simp
  · rw [h₀, htop, Finset.compl_empty]

/-- The long Weyl element conjugates the big-cell step: an element fixing `1` and moving a pure
spinor `y` with `y_{top} ≠ 0` to the line of `[pt_X]`. -/
theorem sc_stepE (hn : 0 < n) {y : S F n} (hy : IsMaxIsotropic F n (ann F n y))
    (htop : (basisS F n).repr y Finset.univ ≠ 0) :
    ∃ u ∈ Subgroup.closure (sc_weylSet F n ∪ sc_xpSet F n),
      (∃ c : F, m F n (u : C F n) y = c • pt F n) ∧ m F n (u : C F n) 1 = 1 := by
  obtain ⟨s, hs, ε₀, ε₁, hε₀, hε₁, hspt, hs1, hsy⟩ := sc_longWeyl (F := F) hn
  have hz : IsMaxIsotropic F n (ann F n (m F n (s : C F n) y)) := sc_isMaxIsotropic_m s hy
  have hz0 : (basisS F n).repr (m F n (s : C F n) y) ∅ ≠ 0 := by
    rw [hsy]; exact mul_ne_zero hε₀ htop
  obtain ⟨u₀, hu₀, hu₀z⟩ := sc_bigcell hz hz0
  have hsinv1 : m F n ((s⁻¹ : Spin F n) : C F n) 1 = ε₀⁻¹ • pt F n := by
    have := congrArg (m F n ((s⁻¹ : Spin F n) : C F n)) hspt
    rw [fnd_m_inv_m, map_smul] at this
    rw [this, smul_smul, inv_mul_cancel₀ hε₀, one_smul]
  have hsinvpt : m F n ((s⁻¹ : Spin F n) : C F n) (pt F n) = ε₁⁻¹ • 1 := by
    have := congrArg (m F n ((s⁻¹ : Spin F n) : C F n)) hs1
    rw [fnd_m_inv_m, map_smul] at this
    rw [this, smul_smul, inv_mul_cancel₀ hε₁, one_smul]
  have hcl : ∀ g, g ∈ Subgroup.closure (sc_weylSet F n) →
      g ∈ Subgroup.closure (sc_weylSet F n ∪ sc_xpSet F n) :=
    fun g hg => Subgroup.closure_mono Set.subset_union_left hg
  have hcl' : ∀ g, g ∈ Subgroup.closure (sc_xpSet F n) →
      g ∈ Subgroup.closure (sc_weylSet F n ∪ sc_xpSet F n) :=
    fun g hg => Subgroup.closure_mono Set.subset_union_right hg
  refine ⟨s⁻¹ * u₀ * s, Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ (hcl s hs))
    (hcl' u₀ hu₀)) (hcl s hs), ⟨(basisS F n).repr (m F n (s : C F n) y) ∅ * ε₀⁻¹, ?_⟩, ?_⟩
  · rw [sc_m_mul, sc_m_mul, hu₀z, map_smul, hsinv1, smul_smul]
  · rw [sc_m_mul, sc_m_mul, hs1, map_smul, sc_xp_fix_pt u₀ hu₀, map_smul, hsinvpt, smul_smul,
      mul_inv_cancel₀ hε₁, one_smul]

/-! ### Levi and Igusa generators, and generation -/

omit [CharZero F] in
theorem sc_polar_E_F {i j : Fin (2 * n)} (hij : i ≠ j) (c : F) :
    QuadraticMap.polar (Q F n) ((0, e F n j) : V F n) (c • ((f F n i, 0) : V F n)) = 0 := by
  rw [TauCeti.polar_dualProd]
  simp [f, e, Ne.symm hij]

/-- The Levi element `1 + c f_i e_j` (`i ≠ j`), the Spin lift of an Eichler transvection. -/
noncomputable def sc_xl (i j : Fin (2 * n)) (hij : i ≠ j) (c : F) : Spin F n :=
  spinTransvection sc_Q_nondegenerate (sc_Q_E (e F n j)) (sc_polar_E_F hij c)

omit [CharZero F] in
theorem sc_pairing_F_E (i k : Fin (2 * n)) :
    pairing F n ((f F n i, 0) : V F n) (0, e F n k) = if i = k then 1 else 0 := by
  show QuadraticMap.polar (Q F n) _ _ = _
  rw [TauCeti.polar_dualProd]
  simp [f, e, Pi.single_apply]

/-- Igusa's element `s(r)` for the hyperbolic pair `f₁, e₁`. -/
noncomputable def sc_hd (hn : 0 < n) (r : F) (hr : r ≠ 0) : Spin F n :=
  ⟨igusaFactor ((f F n ⟨0, by omega⟩, 0) : V F n) (0, e F n ⟨0, by omega⟩) (Units.mk0 r hr),
    igusa_sec2_mem _ _ (by
      show QuadraticMap.polar (Q F n) _ _ = 0
      rw [TauCeti.polar_dualProd]; simp)
      (by show QuadraticMap.polar (Q F n) _ _ = 0; rw [TauCeti.polar_dualProd]; simp)
      (by rw [sc_pairing_F_E, ite_eq_left rfl]) _⟩

/-- The generators of `Spin(V_F)`: root, Weyl, Levi, Igusa elements, and `-1`. -/
def sc_genSet (F : Type*) [Field F] [CharZero F] (n : ℕ) (hn : 0 < n) : Set (Spin F n) :=
  sc_xpSet F n ∪ sc_weylSet F n ∪
    {g | ∃ (i j : Fin (2 * n)) (hij : i ≠ j) (c : F), g = sc_xl i j hij c} ∪
    {g | ∃ (r : F) (hr : r ≠ 0), g = sc_hd hn r hr} ∪ {⟨-1, sc_neg_one_mem hn⟩}

/-- `ker m_1 = H¹(X̂) × 0` with the basis `(f_i, 0)`. -/
noncomputable def sc_annOneEquiv (F : Type*) [Field F] [CharZero F] (n : ℕ) :
    Module.Dual F (H1 F n) ≃ₗ[F] ann F n 1 where
  toFun θ := ⟨(θ, 0), (sc_mem_ann_one _).mpr rfl⟩
  invFun v := (v : V F n).1
  map_add' _ _ := by ext <;> simp
  map_smul' _ _ := by ext <;> simp
  left_inv _ := rfl
  right_inv v := by
    apply Subtype.ext
    exact Prod.ext rfl ((sc_mem_ann_one (v : V F n)).mp v.2).symm

/-- The basis `(f_i, 0)` of `ker m_1`. -/
noncomputable def sc_stdBasis (F : Type*) [Field F] [CharZero F] (n : ℕ) :
    Module.Basis (Fin (2 * n)) F (ann F n 1) :=
  ((Pi.basisFun F (Fin (2 * n))).dualBasis).map (sc_annOneEquiv F n)

theorem sc_stdBasis_apply (i : Fin (2 * n)) :
    ((sc_stdBasis F n i : ann F n 1) : V F n) = (f F n i, 0) := by
  simp only [sc_stdBasis, Module.Basis.map_apply, sc_annOneEquiv, LinearEquiv.coe_mk,
    Module.Basis.coe_dualBasis]
  rw [sc_f_eq]
  rfl

/-- The stabilizer of the lines of `1` and `[pt_X]` lies in the subgroup generated by
`sc_genSet` (`sc_le_of_lifts` for the standard bases). -/
theorem sc_stab_le_closure (hn : 0 < n) :
    lineStabilizer F n 1 ⊓ lineStabilizer F n (pt F n) ≤ Subgroup.closure (sc_genSet F n hn) := by
  refine sc_le_of_lifts hn sc_isEvenPureSpinor_one sc_isEvenPureSpinor_pt sc_ann_one_inf_ann_pt
    (sc_stdBasis F n) (fun k => ((0, e F n k) : V F n))
    (fun k => (sc_mem_ann_pt _).mpr rfl)
    (fun i k => by rw [sc_stdBasis_apply, sc_pairing_F_E]) _ ?_ ?_ ?_
  · intro i j hij c g hg
    apply Subgroup.subset_closure
    refine Or.inl (Or.inl (Or.inr ⟨i, j, hij, c, ?_⟩))
    apply Subtype.ext
    rw [hg, sc_stdBasis_apply, sc_xl, coe_spinTransvection]
  · intro r hr g hg
    apply Subgroup.subset_closure
    refine Or.inl (Or.inr ⟨r, hr, ?_⟩)
    apply Subtype.ext
    rw [hg, sc_stdBasis_apply]
    rfl
  · intro g hg
    apply Subgroup.subset_closure
    refine Or.inr ?_
    exact Subtype.ext hg

/-- **Generation**: `Spin(V_F)` is generated by `sc_genSet` (`n > 0`). -/
theorem sc_closure_genSet_eq_top (hn : 0 < n) : Subgroup.closure (sc_genSet F n hn) = ⊤ := by
  rw [eq_top_iff]
  intro g _
  set E := Subgroup.closure (sc_genSet F n hn)
  have hW : ∀ x, x ∈ Subgroup.closure (sc_weylSet F n) → x ∈ E := fun x hx =>
    Subgroup.closure_mono (fun y hy => Or.inl (Or.inl (Or.inl (Or.inr hy)))) hx
  have hX : ∀ x, x ∈ Subgroup.closure (sc_xpSet F n) → x ∈ E := fun x hx =>
    Subgroup.closure_mono (fun y hy => Or.inl (Or.inl (Or.inl (Or.inl hy)))) hx
  have hWX : ∀ x, x ∈ Subgroup.closure (sc_weylSet F n ∪ sc_xpSet F n) → x ∈ E := fun x hx =>
    Subgroup.closure_mono (fun y hy => by
      rcases hy with hy | hy
      · exact Or.inl (Or.inl (Or.inl (Or.inr hy)))
      · exact Or.inl (Or.inl (Or.inl (Or.inl hy)))) hx
  -- `z = g · 1` is a nonzero element of `S⁺`; move it into the big cell, then to the line of `1`
  set z := m F n (g : C F n) 1 with hzdef
  have hzS : z ∈ Splus F n := sc_m_mem_Splus g sc_one_mem_Splus
  have hz0 : z ≠ 0 := fun h => sc_one_ne_zero (sc_m_injective g (by rw [← hzdef, h, map_zero]))
  obtain ⟨s₁, hs₁, hs₁z⟩ := sc_exists_weyl_ne z hzS hz0
  obtain ⟨u₁, hu₁, hu₁z⟩ := sc_bigcell (sc_isMaxIsotropic_m s₁
    (sc_isMaxIsotropic_m g sc_isEvenPureSpinor_one.2)) hs₁z
  set c := (basisS F n).repr (m F n (s₁ : C F n) z) ∅ with hc
  set h := u₁ * s₁ * g with hh
  have hh1 : m F n (h : C F n) 1 = c • 1 := by
    rw [hh, sc_m_mul, sc_m_mul, ← hzdef, hu₁z]
  have hhst : h ∈ lineStabilizer F n 1 := ⟨c, hh1⟩
  -- `y = h · [pt_X]`: move it to the line of `[pt_X]`, fixing `1`
  obtain ⟨u', hu', ⟨c', hc'⟩, hu'1⟩ := sc_stepE hn
    (sc_isMaxIsotropic_m h sc_isEvenPureSpinor_pt.2) (sc_top_ne_zero hn h hhst)
  have hk : u' * h ∈ lineStabilizer F n 1 ⊓ lineStabilizer F n (pt F n) := by
    refine Subgroup.mem_inf.mpr ⟨⟨c, ?_⟩, ⟨c', ?_⟩⟩
    · rw [sc_m_mul, hh1, map_smul, hu'1]
    · rw [sc_m_mul, hc']
  have hkE : u' * h ∈ E := sc_stab_le_closure hn hk
  have hg : g = s₁⁻¹ * u₁⁻¹ * u'⁻¹ * (u' * h) := by
    rw [hh]; group
  rw [hg]
  exact E.mul_mem (E.mul_mem (E.mul_mem (E.inv_mem (hW s₁ hs₁)) (E.inv_mem (hX u₁ hu₁)))
    (E.inv_mem (hWX u' hu'))) hkE

end SCGen


/-! ## Helpers (prover SC): the Igusa quartic in coordinates and its invariance under the generators

The coordinates of `x ∈ S_F` (`n = 3`) are indexed by bit masks `k < 64` (`sc_cm x k`, the
coefficient of `e_K` for `K = {i : bit i of k is set}`), and `J` is an explicit quartic `sc_JcM` in
them (`sc_J_eqM`). Each generator of `Spin(V_F)` acts on these coordinates by explicit formulas
(`sc_cm_ι_e`, `sc_cm_D_f`), and the invariance of `J` under it is a polynomial identity. -/

section SCMask

set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false

variable {F : Type*} [Field F] [CharZero F]

theorem sc_sum_pair6 {R : Type*} [AddCommMonoid R] (g : Pair6 → R) : ∑ p, g p =
    g ⟨(0,1), by decide⟩ + g ⟨(0,2), by decide⟩ + g ⟨(0,3), by decide⟩ + g ⟨(0,4), by decide⟩ +
    g ⟨(0,5), by decide⟩ + g ⟨(1,2), by decide⟩ + g ⟨(1,3), by decide⟩ + g ⟨(1,4), by decide⟩ +
    g ⟨(1,5), by decide⟩ + g ⟨(2,3), by decide⟩ + g ⟨(2,4), by decide⟩ + g ⟨(2,5), by decide⟩ +
    g ⟨(3,4), by decide⟩ + g ⟨(3,5), by decide⟩ + g ⟨(4,5), by decide⟩ := by
  classical
  let g' : Fin 6 × Fin 6 → R := fun q => if h : q.1 < q.2 then g ⟨q, h⟩ else 0
  have h1 : ∑ p, g p = ∑ p : Pair6, g' p.1 := by
    refine Finset.sum_congr rfl fun p _ => ?_
    simp [g', p.2]
  have h2 : ∑ p : Pair6, g' p.1 = ∑ q, g' q := by
    rw [← Finset.sum_subtype (Finset.univ.filter fun q : Fin 6 × Fin 6 => q.1 < q.2)
      (by simp) g', Finset.sum_filter]
    refine Finset.sum_congr rfl fun q _ => ?_
    split_ifs with h
    · rfl
    · simp [g', h]
  rw [h1, h2, Fintype.sum_prod_type]
  simp only [Fin.sum_univ_six, g']
  simp
  abel

theorem sc_pf6_expand {R : Type*} [CommRing R] (A : Matrix (Fin 6) (Fin 6) R) :
    pf6 A = A 0 1 * (A 2 4 * A 3 5 - A 2 3 * A 4 5 - A 2 5 * A 3 4) -
      A 0 2 * (A 1 4 * A 3 5 - A 1 3 * A 4 5 - A 1 5 * A 3 4) +
      A 0 3 * (A 1 4 * A 2 5 - A 1 2 * A 4 5 - A 1 5 * A 2 4) -
      A 0 4 * (A 1 3 * A 2 5 - A 1 2 * A 3 5 - A 1 5 * A 2 3) +
      A 0 5 * (A 1 3 * A 2 4 - A 1 2 * A 3 4 - A 1 4 * A 2 3) := by
  have hs : ∀ j : Fin 5, skipTwo ⟨((0 : Fin 6), j.succ), Fin.succ_pos _⟩ =
      ![(if j = 0 then 2 else 1), (if j ≤ 1 then 3 else 2), (if j ≤ 2 then 4 else 3),
        (if j ≤ 3 then 5 else 4)] := by
    intro j; funext k; fin_cases j <;> fin_cases k <;> rfl
  simp only [pf6, pf4, crossOut, Matrix.submatrix_apply, Fin.sum_univ_five, hs]
  simp only [Fin.succ_zero_eq_one, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.cons_val_three]
  norm_num
  ring

