    c 12)) + ((c 20 * c 40 - c 12 * c 48 - c 36 * c 24) * ((-c 43) * (-c 23) - c 51 * c 15 -
    c 27 * c 39) + (c 18 * c 40 - c 10 * c 48 - c 34 * c 24) * (c 45 * (-c 23) - (-c 53) * c 15 -
    (-c 29) * c 39) + (c 18 * c 36 - c 6 * c 48 - c 34 * c 20) * (c 45 * c 27 - c 57 * c 15 -
    (-c 29) * (-c 43)) + (c 10 * c 36 - c 6 * c 40 - c 34 * c 12) * ((-c 53) * c 27 - c 57 *
    (-c 23) - (-c 29) * c 51) + (c 10 * c 20 - c 6 * c 24 - c 18 * c 12) * ((-c 53) * (-c 43) -
    c 57 * c 39 - c 45 * c 51) + (c 17 * c 40 - c 9 * c 48 - c 33 * c 24) * ((-c 46) * (-c 23) -
    c 54 * c 15 - c 30 * c 39) + (c 17 * c 36 - c 5 * c 48 - c 33 * c 20) * ((-c 46) * c 27 -
    (-c 58) * c 15 - c 30 * (-c 43)) + (c 9 * c 36 - c 5 * c 40 - c 33 * c 12) * (c 54 * c 27 -
    (-c 58) * (-c 23) - c 30 * c 51) + (c 9 * c 20 - c 5 * c 24 - c 17 * c 12) * (c 54 *
    (-c 43) - (-c 58) * c 39 - (-c 46) * c 51) + (c 17 * c 34 - c 3 * c 48 - c 33 * c 18) *
    ((-c 46) * (-c 29) - c 60 * c 15 - c 30 * c 45) + (c 9 * c 34 - c 3 * c 40 - c 33 * c 10) *
